<Tag Name="CntByCode" TagType="Base" DataType="DINT" Dimensions="32" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Parts per NOK code]]></Description><Data Format="Decorated"><Array DataType="DINT" Dimensions="32" Radix="Decimal"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="0"/><Element Index="[2]" Value="0"/><Element Index="[3]" Value="0"/><Element Index="[4]" Value="0"/><Element Index="[5]" Value="0"/><Element Index="[6]" Value="0"/><Element Index="[7]" Value="0"/><Element Index="[8]" Value="0"/><Element Index="[9]" Value="0"/><Element Index="[10]" Value="0"/><Element Index="[11]" Value="0"/><Element Index="[12]" Value="0"/><Element Index="[13]" Value="0"/><Element Index="[14]" Value="0"/><Element Index="[15]" Value="0"/><Element Index="[16]" Value="0"/><Element Index="[17]" Value="0"/><Element Index="[18]" Value="0"/><Element Index="[19]" Value="0"/><Element Index="[20]" Value="0"/><Element Index="[21]" Value="0"/><Element Index="[22]" Value="0"/><Element Index="[23]" Value="0"/><Element Index="[24]" Value="0"/><Element Index="[25]" Value="0"/><Element Index="[26]" Value="0"/><Element Index="[27]" Value="0"/><Element Index="[28]" Value="0"/><Element Index="[29]" Value="0"/><Element Index="[30]" Value="0"/><Element Index="[31]" Value="0"/></Array></Data></Tag>
<Tag Name="AlmAck" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Programmatic acknowledge of all station alarms]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="AlmZero" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Always 0: unused ALMD operands]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_SafetyOpen_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_SafetyOpen]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_SafetyOpen" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Fault 1: safety circuit open]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="900" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
<Tag Name="ALM_DriveNotReady_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_DriveNotReady]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_DriveNotReady" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Fault 2: drive not ready]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="800" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
<Tag Name="ALM_ClampTimeout_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_ClampTimeout]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_ClampTimeout" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Fault 3: clamp did not close in time]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="700" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
<Tag Name="ALM_TareFailed_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_TareFailed]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_TareFailed" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Fault 4: load cell does not tare]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="700" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
<Tag Name="ALM_RejectWaiting_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_RejectWaiting]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_RejectWaiting" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Reject lock: part waits for the reject chute]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="500" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
<Tag Name="ALM_RigCheck_In" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Description><![CDATA[Condition of ALM_RigCheck]]></Description><Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="ALM_RigCheck" TagType="Base" DataType="ALARM_DIGITAL" ExternalAccess="Read/Write"><Description><![CDATA[Three rejects in a row: run the master part]]></Description><Data Format="Alarm"><AlarmDigitalParameters Severity="600" MinDurationPRE="0" ShelveDuration="0" MaxShelveDuration="0" ProgTime="DT#1970-01-01-00:00:00.000_000Z" EnableIn="false" In="false" InFault="false" Condition="true" AckRequired="true" Latched="false" ProgAck="false" OperAck="false" ProgReset="false" OperReset="false" ProgSuppress="false" OperSuppress="false" ProgUnsuppress="false" OperUnsuppress="false" OperShelve="false" ProgUnshelve="false" OperUnshelve="false" ProgDisable="false" OperDisable="false" ProgEnable="false" OperEnable="false" AlarmCountReset="false" UseProgTime="false"/><AlarmConfig/></Data></Tag>
</Tags>
<Routines>
<Routine Name="Station" Type="ST">
<STContent>
<Line Number="0"><![CDATA[// The station on the machine, in the periodic task StationTask (Rate 2 ms).]]></Line>
<Line Number="1"><![CDATA[// The I/O mapping (Station.SafetyOk, Station.Pos, Station.Force ... from the input modules, and the]]></Line>
<Line Number="2"><![CDATA[// outputs QClamp, QVel ... to the output modules) depends on the modules and is not part of this port.]]></Line>
<Line Number="3"><![CDATA[// CycleTime is the time base of every timer in the station: it must equal the task Rate.]]></Line>
<Line Number="4"><![CDATA[Station.CycleTime := 0.002;]]></Line>
<Line Number="5"><![CDATA[AOI_HandleStation(Station, Rcp, CntByCode);]]></Line>
<Line Number="6"><![CDATA[]]></Line>
<Line Number="7"><![CDATA[// --- Alarms: one ALMD per condition (Logix alarm instruction; the panel or FactoryTalk shows them) ---]]></Line>
<Line Number="8"><![CDATA[ALM_SafetyOpen_In := Station.FaultCode = 1;]]></Line>
<Line Number="9"><![CDATA[ALMD(ALM_SafetyOpen, ALM_SafetyOpen_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
<Line Number="10"><![CDATA[ALM_DriveNotReady_In := Station.FaultCode = 2;]]></Line>
<Line Number="11"><![CDATA[ALMD(ALM_DriveNotReady, ALM_DriveNotReady_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
<Line Number="12"><![CDATA[ALM_ClampTimeout_In := Station.FaultCode = 3;]]></Line>
<Line Number="13"><![CDATA[ALMD(ALM_ClampTimeout, ALM_ClampTimeout_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
<Line Number="14"><![CDATA[ALM_TareFailed_In := Station.FaultCode = 4;]]></Line>
<Line Number="15"><![CDATA[ALMD(ALM_TareFailed, ALM_TareFailed_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
<Line Number="16"><![CDATA[ALM_RejectWaiting_In := Station.Locked AND Station.QCallOperator;]]></Line>
<Line Number="17"><![CDATA[ALMD(ALM_RejectWaiting, ALM_RejectWaiting_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
<Line Number="18"><![CDATA[ALM_RigCheck_In := Station.RigCheckRequired;]]></Line>
<Line Number="19"><![CDATA[ALMD(ALM_RigCheck, ALM_RigCheck_In, AlmAck, AlmZero, AlmZero, AlmZero);]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="BenchTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false"><ScheduledPrograms><ScheduledProgram Name="BenchProgram"/></ScheduledPrograms></Task>
<Task Name="StationTask" Type="PERIODIC" Rate="2" Priority="5" Watchdog="10" DisableUpdateOutputs="false" InhibitTask="true"><ScheduledPrograms><ScheduledProgram Name="StationProgram"/></ScheduledPrograms></Task>
</Tasks>
</Controller>
</RSLogix5000Content>
