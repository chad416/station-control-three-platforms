lue="0.0"/><Element Index="[44]" Value="0.0"/><Element Index="[45]" Value="0.0"/><Element Index="[46]" Value="0.0"/><Element Index="[47]" Value="0.0"/><Element Index="[48]" Value="0.0"/><Element Index="[49]" Value="0.0"/><Element Index="[50]" Value="0.0"/><Element Index="[51]" Value="0.0"/><Element Index="[52]" Value="0.0"/><Element Index="[53]" Value="0.0"/><Element Index="[54]" Value="0.0"/><Element Index="[55]" Value="0.0"/><Element Index="[56]" Value="0.0"/><Element Index="[57]" Value="0.0"/><Element Index="[58]" Value="0.0"/><Element Index="[59]" Value="0.0"/><Element Index="[60]" Value="0.0"/><Element Index="[61]" Value="0.0"/><Element Index="[62]" Value="0.0"/><Element Index="[63]" Value="0.0"/></ArrayMember></Structure></Data></Tag>
<Tag Name="StationCnt" TagType="Base" DataType="DINT" Dimensions="32" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="DINT" Dimensions="32" Radix="Decimal"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="0"/><Element Index="[2]" Value="0"/><Element Index="[3]" Value="0"/><Element Index="[4]" Value="0"/><Element Index="[5]" Value="0"/><Element Index="[6]" Value="0"/><Element Index="[7]" Value="0"/><Element Index="[8]" Value="0"/><Element Index="[9]" Value="0"/><Element Index="[10]" Value="0"/><Element Index="[11]" Value="0"/><Element Index="[12]" Value="0"/><Element Index="[13]" Value="0"/><Element Index="[14]" Value="0"/><Element Index="[15]" Value="0"/><Element Index="[16]" Value="0"/><Element Index="[17]" Value="0"/><Element Index="[18]" Value="0"/><Element Index="[19]" Value="0"/><Element Index="[20]" Value="0"/><Element Index="[21]" Value="0"/><Element Index="[22]" Value="0"/><Element Index="[23]" Value="0"/><Element Index="[24]" Value="0"/><Element Index="[25]" Value="0"/><Element Index="[26]" Value="0"/><Element Index="[27]" Value="0"/><Element Index="[28]" Value="0"/><Element Index="[29]" Value="0"/><Element Index="[30]" Value="0"/><Element Index="[31]" Value="0"/></Array></Data></Tag>
</Tags>
<Routines>
<Routine Name="Bench" Type="ST">
<STContent>
<Line Number="0"><![CDATA[]]></Line>
<Line Number="1"><![CDATA[    // --- Start ---]]></Line>
<Line Number="2"><![CDATA[        IF sPhase = 0 THEN]]></Line>
<Line Number="3"><![CDATA[            FOR tI := 1 TO 32 DO]]></Line>
<Line Number="4"><![CDATA[                TR_CasePass[tI] := 0;]]></Line>
<Line Number="5"><![CDATA[                TR_CaseCheck[tI] := 0;]]></Line>
<Line Number="6"><![CDATA[                TR_CaseNok[tI] := 0;]]></Line>
<Line Number="7"><![CDATA[            END_FOR;]]></Line>
<Line Number="8"><![CDATA[            // the part of the recipe that is the same in every case, for both evaluation instances]]></Line>
<Line Number="9"><![CDATA[            BenchRcp.GateX := TD_GateX;]]></Line>
<Line Number="10"><![CDATA[            BenchRcp.Gate2X := TD_Gate2X;]]></Line>
<Line Number="11"><![CDATA[            BenchRcp.PeakXLo := TD_PeakXLo;]]></Line>
<Line Number="12"><![CDATA[            BenchRcp.PeakXHi := TD_PeakXHi;]]></Line>
<Line Number="13"><![CDATA[            BenchRcp.StepSpan := TD_StepSpan;]]></Line>
<Line Number="14"><![CDATA[            BenchRcp.StopF := TD_StopF;]]></Line>
<Line Number="15"><![CDATA[            BenchRcp.EnvX0 := TD_EnvX0;]]></Line>
<Line Number="16"><![CDATA[            BenchRcp.EnvDx := TD_EnvDx;]]></Line>
<Line Number="17"><![CDATA[            BenchRcp.EnvN := TD_EnvN;]]></Line>
<Line Number="18"><![CDATA[            StationRcp.GateX := TD_GateX;]]></Line>
<Line Number="19"><![CDATA[            StationRcp.Gate2X := TD_Gate2X;]]></Line>
<Line Number="20"><![CDATA[            StationRcp.PeakXLo := TD_PeakXLo;]]></Line>
<Line Number="21"><![CDATA[            StationRcp.PeakXHi := TD_PeakXHi;]]></Line>
<Line Number="22"><![CDATA[            StationRcp.StepSpan := TD_StepSpan;]]></Line>
<Line Number="23"><![CDATA[            StationRcp.StopF := TD_StopF;]]></Line>
<Line Number="24"><![CDATA[            StationRcp.EnvX0 := TD_EnvX0;]]></Line>
<Line Number="25"><![CDATA[            StationRcp.EnvDx := TD_EnvDx;]]></Line>
<Line Number="26"><![CDATA[            StationRcp.EnvN := TD_EnvN;]]></Line>
<Line Number="27"><![CDATA[            FOR tI := 0 TO 63 DO]]></Line>
<Line Number="28"><![CDATA[                BenchRcp.EnvLo[tI] := TD_EnvLo[tI];]]></Line>
<Line Number="29"><![CDATA[                BenchRcp.EnvHi[tI] := TD_EnvHi[tI];]]></Line>
<Line Number="30"><![CDATA[                StationRcp.EnvLo[tI] := TD_EnvLo[tI];]]></Line>
<Line Number="31"><![CDATA[                StationRcp.EnvHi[tI] := TD_EnvHi[tI];]]></Line>
<Line Number="32"><![CDATA[            END_FOR;]]></Line>
<Line Number="33"><![CDATA[            // the station judges with windows + return stroke (mode 3: limits 32..47)]]></Line>
<Line Number="34"><![CDATA[            StationRcp.Mode := 3;]]></Line>
<Line Number="35"><![CDATA[            StationRcp.G1Lo := TD_Lim[32];]]></Line>
<Line Number="36"><![CDATA[            StationRcp.G1Hi := TD_Lim[33];]]></Line>
<Line Number="37"><![CDATA[            StationRcp.MeanLo := TD_Lim[34];]]></Line>
<Line Number="38"><![CDATA[            StationRcp.MeanHi := TD_Lim[35];]]></Line>
<Line Number="39"><![CDATA[            StationRcp.HystLo := TD_Lim[36];]]></Line>
<Line Number="40"><![CDATA[            StationRcp.HystHi := TD_Lim[37];]]></Line>
<Line Number="41"><![CDATA[            StationRcp.RetFMin := TD_Lim[38];]]></Line>
<Line Number="42"><![CDATA[            StationRcp.G2Lo := TD_Lim[39];]]></Line>
<Line Number="43"><![CDATA[            StationRcp.G2Hi := TD_Lim[40];]]></Line>
<Line Number="44"><![CDATA[            StationRcp.PeakFLo := TD_Lim[41];]]></Line>
<Line Number="45"><![CDATA[            StationRcp.PeakFHi := TD_Lim[42];]]></Line>
<Line Number="46"><![CDATA[            StationRcp.PeakXMin := TD_Lim[43];]]></Line>
<Line Number="47"><![CDATA[            StationRcp.PeakXMax := TD_Lim[44];]]></Line>
<Line Number="48"><![CDATA[            StationRcp.StepLo := TD_Lim[45];]]></Line>
<Line Number="49"><![CDATA[            StationRcp.StopXLo := TD_Lim[46];]]></Line>
<Line Number="50"><![CDATA[            StationRcp.StopXHi := TD_Lim[47];]]></Line>
<Line Number="51"><![CDATA[            sCase := 1;]]></Line>
<Line Number="52"><![CDATA[            sSub := 0;]]></Line>
<Line Number="53"><![CDATA[            sCk := 0;]]></Line>
<Line Number="54"><![CDATA[            sNok := 0;]]></Line>
<Line Number="55"><![CDATA[            sStep := 10;]]></Line>
<Line Number="56"><![CDATA[            sTim := 0;]]></Line>
<Line Number="57"><![CDATA[            sPhase := 1;]]></Line>
<Line Number="58"><![CDATA[        END_IF;]]></Line>
<Line Number="59"><![CDATA[        IF sPhase < 3 THEN]]></Line>
<Line Number="60"><![CDATA[            sCalls := sCalls + 1;]]></Line>
<Line Number="61"><![CDATA[        END_IF;]]></Line>
<Line Number="62"><![CDATA[]]></Line>
<Line Number="63"><![CDATA[    // --- Replay ---]]></Line>
<Line Number="64"><![CDATA[        IF sPhase = 1 THEN]]></Line>
<Line Number="65"><![CDATA[            FOR tI := 1 TO ReplayPerCall DO]]></Line>
<Line Number="66"><![CDATA[                IF NOT sRecord THEN]]></Line>
<Line Number="67"><![CDATA[                    tCurve := TD_CaseCurve[sCase];]]></Line>
<Line Number="68"><![CDATA[                    tMode := TD_CaseMode[sCase];]]></Line>
<Line Number="69"><![CDATA[                    tA := TD_CurveStart[tCurve];]]></Line>
<Line Number="70"><![CDATA[                    tN := TD_CurveNPull[tCurve];]]></Line>
<Line Number="71"><![CDATA[                    CASE sSub OF]]></Line>
<Line Number="72"><![CDATA[                        0:  // limits of the mode of this case, clear the evaluation]]></Line>
<Line Number="73"><![CDATA[                            tB := (tMode - 1) * 16;]]></Line>
<Line Number="74"><![CDATA[                            BenchRcp.Mode := tMode;]]></Line>
<Line Number="75"><![CDATA[                            BenchRcp.G1Lo := TD_Lim[tB];]]></Line>
<Line Number="76"><![CDATA[                            BenchRcp.G1Hi := TD_Lim[tB + 1];]]></Line>
<Line Number="77"><![CDATA[                            BenchRcp.MeanLo := TD_Lim[tB + 2];]]></Line>
<Line Number="78"><![CDATA[                            BenchRcp.MeanHi := TD_Lim[tB + 3];]]></Line>
<Line Number="79"><![CDATA[                            BenchRcp.HystLo := TD_Lim[tB + 4];]]></Line>
<Line Number="80"><![CDATA[                            BenchRcp.HystHi := TD_Lim[tB + 5];]]></Line>
<Line Number="81"><![CDATA[                            BenchRcp.RetFMin := TD_Lim[tB + 6];]]></Line>
<Line Number="82"><![CDATA[                            BenchRcp.G2Lo := TD_Lim[tB + 7];]]></Line>
<Line Number="83"><![CDATA[                            BenchRcp.G2Hi := TD_Lim[tB + 8];]]></Line>
<Line Number="84"><![CDATA[                            BenchRcp.PeakFLo := TD_Lim[tB + 9];]]></Line>
<Line Number="85"><![CDATA[                            BenchRcp.PeakFHi := TD_Lim[tB + 10];]]></Line>
<Line Number="86"><![CDATA[                            BenchRcp.PeakXMin := TD_Lim[tB + 11];]]></Line>
<Line Number="87"><![CDATA[                            BenchRcp.PeakXMax := TD_Lim[tB + 12];]]></Line>
<Line Number="88"><![CDATA[                            BenchRcp.StepLo := TD_Lim[tB + 13];]]></Line>
<Line Number="89"><![CDATA[                            BenchRcp.StopXLo := TD_Lim[tB + 14];]]></Line>
<Line Number="90"><![CDATA[                            BenchRcp.StopXHi := TD_Lim[tB + 15];]]></Line>
<Line Number="91"><![CDATA[                            Eval.Reset := 1;]]></Line>
<Line Number="92"><![CDATA[                            Eval.Sample := 0;]]></Line>
<Line Number="93"><![CDATA[                            Eval.Stroke := 0;]]></Line>
<Line Number="94"><![CDATA[                            Eval.X := 0.0;]]></Line>
<Line Number="95"><![CDATA[                            Eval.F := 0.0;]]></Line>
<Line Number="96"><![CDATA[                            Eval.Finish := 0;]]></Line>
<Line Number="97"><![CDATA[                            AOI_CurveEval(Eval, BenchRcp);]]></Line>
<Line Number="98"><![CDATA[                            sIdx := 0;]]></Line>
<Line Number="99"><![CDATA[                            sSub := 1;]]></Line>
<Line Number="100"><![CDATA[                        1:  // one sample: the pull samples first, then the return samples]]></Line>
<Line Number="101"><![CDATA[                            IF sIdx < tN THEN]]></Line>
<Line Number="102"><![CDATA[                                tStroke := 1;]]></Line>
<Line Number="103"><![CDATA[                            ELSE]]></Line>
<Line Number="104"><![CDATA[                                tStroke := 2;]]></Line>
<Line Number="105"><![CDATA[                            END_IF;]]></Line>
<Line Number="106"><![CDATA[                            Eval.Reset := 0;]]></Line>
<Line Number="107"><![CDATA[                            Eval.Sample := 1;]]></Line>
<Line Number="108"><![CDATA[                            Eval.Stroke := tStroke;]]></Line>
<Line Number="109"><![CDATA[                            Eval.X := TD_X[tA + sIdx];]]></Line>
<Line Number="110"><![CDATA[                            Eval.F := TD_F[tA + sIdx];]]></Line>
<Line Number="111"><![CDATA[                            Eval.Finish := 0;]]></Line>
<Line Number="112"><![CDATA[                            AOI_CurveEval(Eval, BenchRcp);]]></Line>
<Line Number="113"><![CDATA[                            sIdx := sIdx + 1;]]></Line>
<Line Number="114"><![CDATA[                            IF sIdx >= 2 * tN THEN]]></Line>
<Line Number="115"><![CDATA[                                sSub := 2;]]></Line>
<Line Number="116"><![CDATA[                            END_IF;]]></Line>
<Line Number="117"><![CDATA[                        2:  // judge and compare with the expected values]]></Line>
<Line Number="118"><![CDATA[                            Eval.Reset := 0;]]></Line>
<Line Number="119"><![CDATA[                            Eval.Sample := 0;]]></Line>
<Line Number="120"><![CDATA[                            Eval.Stroke := 0;]]></Line>
<Line Number="121"><![CDATA[                            Eval.X := 0.0;]]></Line>
<Line Number="122"><![CDATA[                            Eval.F := 0.0;]]></Line>
<Line Number="123"><![CDATA[                            Eval.Finish := 1;]]></Line>
<Line Number="124"><![CDATA[                            AOI_CurveEval(Eval, BenchRcp);]]></Line>
<Line Number="125"><![CDATA[                            sMeas[0] := Eval.FpG1;]]></Line>
<Line Number="126"><![CDATA[                            sMeas[1] := Eval.FrG1;]]></Line>
<Line Number="127"><![CDATA[                            sMeas[2] := Eval.FMean;]]></Line>
<Line Number="128"><![CDATA[                            sMeas[3] := Eval.FHyst;]]></Line>
<Line Number="129"><![CDATA[                            sMeas[4] := Eval.FpG2;]]></Line>
<Line Number="130"><![CDATA[                            sMeas[5] := Eval.FPeak;]]></Line>
<Line Number="131"><![CDATA[                            sMeas[6] := Eval.XPeak;]]></Line>
<Line Number="132"><![CDATA[                            sMeas[7] := Eval.FStep;]]></Line>
<Line Number="133"><![CDATA[                            sMeas[8] := Eval.XStop;]]></Line>
<Line Number="134"><![CDATA[                            IF Eval.Ok XOR TD_ExpOk[sCase] THEN]]></Line>
<Line Number="135"><![CDATA[                                sCk := 1;]]></Line>
<Line Number="136"><![CDATA[                            ELSIF Eval.NokCode <> TD_ExpNok[sCase] THEN]]></Line>
<Line Number="137"><![CDATA[                                sCk := 2;]]></Line>
<Line Number="138"><![CDATA[                            ELSIF Eval.EnvViol <> TD_ExpEnvViol[sCase] THEN]]></Line>
<Line Number="139"><![CDATA[                                sCk := 12;]]></Line>
<Line Number="140"><![CDATA[                            ELSIF Eval.EnvNodes <> TD_ExpEnvNodes[sCase] THEN]]></Line>
<Line Number="141"><![CDATA[                                sCk := 13;]]></Line>
<Line Number="142"><![CDATA[                            END_IF;]]></Line>
<Line Number="143"><![CDATA[                            FOR tJ := 0 TO 8 DO]]></Line>
<Line Number="144"><![CDATA[                                tB := (sCase - 1) * 9 + tJ;]]></Line>
<Line Number="145"><![CDATA[                                IF TD_ExpFeatValid[tB] THEN]]></Line>
<Line Number="146"><![CDATA[                                    tErr := ABS(sMeas[tJ] - TD_ExpFeat[tB]);]]></Line>
<Line Number="147"><![CDATA[                                    IF tErr > sMaxErr THEN]]></Line>
<Line Number="148"><![CDATA[                                        sMaxErr := tErr;]]></Line>
<Line Number="149"><![CDATA[                                    END_IF;]]></Line>
<Line Number="150"><![CDATA[                                    IF tErr > TD_Tol AND sCk = 0 THEN]]></Line>
<Line Number="151"><![CDATA[                                        sCk := 3 + tJ;]]></Line>
<Line Number="152"><![CDATA[                                    END_IF;]]></Line>
<Line Number="153"><![CDATA[                                END_IF;]]></Line>
<Line Number="154"><![CDATA[                            END_FOR;]]></Line>
<Line Number="155"><![CDATA[                            sNok := Eval.NokCode;]]></Line>
<Line Number="156"><![CDATA[                            sSub := 0;]]></Line>
<Line Number="157"><![CDATA[                            sRecord := 1;]]></Line>
<Line Number="158"><![CDATA[                    END_CASE;]]></Line>
<Line Number="159"><![CDATA[                END_IF;]]></Line>
<Line Number="160"><![CDATA[            END_FOR;]]></Line>
<Line Number="161"><![CDATA[        END_IF;]]></Line>
<Line Number="162"><![CDATA[]]></Line>
<Line Number="163"><![CDATA[    // --- Station ---]]></Line>
<Line Number="164"><![CDATA[        IF sPhase = 2 THEN]]></Line>
<Line Number="165"><![CDATA[            FOR tI := 1 TO ScansPerCall DO]]></Line>
<Line Number="166"><![CDATA[                IF sPhase = 2 AND NOT sRecord THEN]]></Line>
<Line Number="167"><![CDATA[                    IF sTim < 30000 THEN]]></Line>
<Line Number="168"><![CDATA[                        sTim := sTim + 1;]]></Line>
<Line Number="169"><![CDATA[                    END_IF;]]></Line>
<Line Number="170"><![CDATA[                    // what the operator and the line do, and what the station must have done by now]]></Line>
<Line Number="171"><![CDATA[                    CASE sStep OF]]></Line>
<Line Number="172"><![CDATA[                        10:  // good LH unit]]></Line>
<Line Number="173"><![CDATA[                            sPart := 1;]]></Line>
<Line Number="174"><![CDATA[                            sLH := 1;]]></Line>
<Line Number="175"><![CDATA[                            sRH := 0;]]></Line>
<Line Number="176"><![CDATA[                            sCurve := TD_GoodCurve;]]></Line>
<Line Number="177"><![CDATA[                            sPlantReset := 1;]]></Line>
<Line Number="178"><![CDATA[                            sStep := 11;]]></Line>
<Line Number="179"><![CDATA[                            sTim := 0;]]></Line>
<Line Number="180"><![CDATA[                        11:]]></Line>
<Line Number="181"><![CDATA[                            IF Station.CntTotal >= 1 OR sTim > 4000 THEN]]></Line>
<Line Number="182"><![CDATA[                                IF sTim > 4000 THEN]]></Line>
<Line Number="183"><![CDATA[                                    sCk := 29;]]></Line>
<Line Number="184"><![CDATA[                                ELSIF Station.Verdict <> 1 THEN]]></Line>
<Line Number="185"><![CDATA[                                    sCk := 21;]]></Line>
<Line Number="186"><![CDATA[                                ELSIF Station.NokCode <> 0 THEN]]></Line>
<Line Number="187"><![CDATA[                                    sCk := 22;]]></Line>
<Line Number="188"><![CDATA[                                ELSIF Station.CntOk <> 1 OR Station.CntNok <> 0 THEN]]></Line>
<Line Number="189"><![CDATA[                                    sCk := 24;]]></Line>
<Line Number="190"><![CDATA[                                ELSIF NOT Plant.Moved THEN]]></Line>
<Line Number="191"><![CDATA[                                    sCk := 25;]]></Line>
<Line Number="192"><![CDATA[                                END_IF;]]></Line>
<Line Number="193"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="194"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="195"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="196"><![CDATA[                                sStep := 12;]]></Line>
<Line Number="197"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="198"><![CDATA[                            END_IF;]]></Line>
<Line Number="199"><![CDATA[                        12:  // unit taken out]]></Line>
<Line Number="200"><![CDATA[                            IF Station.State = 0 OR sTim > 4000 THEN]]></Line>
<Line Number="201"><![CDATA[                                sStep := 20;]]></Line>
<Line Number="202"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="203"><![CDATA[                            END_IF;]]></Line>
<Line Number="204"><![CDATA[                        20:  // RH unit while LH units are built]]></Line>
<Line Number="205"><![CDATA[                            sPart := 1;]]></Line>
<Line Number="206"><![CDATA[                            sLH := 0;]]></Line>
<Line Number="207"><![CDATA[                            sRH := 1;]]></Line>
<Line Number="208"><![CDATA[                            sCurve := TD_GoodCurve;]]></Line>
<Line Number="209"><![CDATA[                            sPlantReset := 1;]]></Line>
<Line Number="210"><![CDATA[                            sStep := 21;]]></Line>
<Line Number="211"><![CDATA[                            sTim := 0;]]></Line>
<Line Number="212"><![CDATA[                        21:]]></Line>
<Line Number="213"><![CDATA[                            IF Station.CntTotal >= 2 OR sTim > 4000 THEN]]></Line>
<Line Number="214"><![CDATA[                                IF sTim > 4000 THEN]]></Line>
<Line Number="215"><![CDATA[                                    sCk := 29;]]></Line>
<Line Number="216"><![CDATA[                                ELSIF Station.Verdict <> 2 THEN]]></Line>
<Line Number="217"><![CDATA[                                    sCk := 21;]]></Line>
<Line Number="218"><![CDATA[                                ELSIF Station.NokCode <> 20 THEN]]></Line>
<Line Number="219"><![CDATA[                                    sCk := 22;]]></Line>
<Line Number="220"><![CDATA[                                ELSIF Station.State <> 8 THEN]]></Line>
<Line Number="221"><![CDATA[                                    sCk := 23;]]></Line>
<Line Number="222"><![CDATA[                                ELSIF Plant.Moved OR Plant.Pos > 0.0 OR NOT Plant.ClampOpen THEN]]></Line>
<Line Number="223"><![CDATA[                                    sCk := 25;]]></Line>
<Line Number="224"><![CDATA[                                END_IF;]]></Line>
<Line Number="225"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="226"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="227"><![CDATA[                                sStep := 22;]]></Line>
<Line Number="228"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="229"><![CDATA[                            END_IF;]]></Line>
<Line Number="230"><![CDATA[                        22:  // reject lock: a chute signal while the rejected unit is still in the fixture]]></Line>
<Line Number="231"><![CDATA[                            sChute := sTim >= 5 AND sTim < 10;]]></Line>
<Line Number="232"><![CDATA[                            IF sTim >= 20 THEN]]></Line>
<Line Number="233"><![CDATA[                                IF Station.State <> 8 OR NOT Station.Locked THEN]]></Line>
<Line Number="234"><![CDATA[                                    sCk := 26;]]></Line>
<Line Number="235"><![CDATA[                                END_IF;]]></Line>
<Line Number="236"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="237"><![CDATA[                                sStep := 23;]]></Line>
<Line Number="238"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="239"><![CDATA[                            END_IF;]]></Line>
<Line Number="240"><![CDATA[                        23:  // the unit is taken out and a new good unit is put in without using the chute]]></Line>
<Line Number="241"><![CDATA[                            IF sTim = 20 THEN]]></Line>
<Line Number="242"><![CDATA[                                sPart := 1;]]></Line>
<Line Number="243"><![CDATA[                                sLH := 1;]]></Line>
<Line Number="244"><![CDATA[                                sRH := 0;]]></Line>
<Line Number="245"><![CDATA[                                sPlantReset := 1;]]></Line>
<Line Number="246"><![CDATA[                            END_IF;]]></Line>
<Line Number="247"><![CDATA[                            IF sTim >= 400 THEN]]></Line>
<Line Number="248"><![CDATA[                                IF sCk = 0 AND (Station.State <> 8 OR Station.CntTotal <> 2 OR Plant.Moved) THEN]]></Line>
<Line Number="249"><![CDATA[                                    sCk := 26;]]></Line>
<Line Number="250"><![CDATA[                                END_IF;]]></Line>
<Line Number="251"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="252"><![CDATA[                                sStep := 24;]]></Line>
<Line Number="253"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="254"><![CDATA[                            END_IF;]]></Line>
<Line Number="255"><![CDATA[                        24:  // fixture empty, the chute sensor sees a part]]></Line>
<Line Number="256"><![CDATA[                            sChute := sTim >= 20 AND sTim < 25;]]></Line>
<Line Number="257"><![CDATA[                            IF sTim >= 40 THEN]]></Line>
<Line Number="258"><![CDATA[                                IF sCk = 0 AND (Station.State <> 0 OR Station.Locked OR Station.CntRejectConfirmed <> 1) THEN]]></Line>
<Line Number="259"><![CDATA[                                    sCk := 27;]]></Line>
<Line Number="260"><![CDATA[                                END_IF;]]></Line>
<Line Number="261"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="262"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="263"><![CDATA[                                sStep := 30;]]></Line>
<Line Number="264"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="265"><![CDATA[                            END_IF;]]></Line>
<Line Number="266"><![CDATA[                        30:  // LH unit with unhooked latch lever]]></Line>
<Line Number="267"><![CDATA[                            sPart := 1;]]></Line>
<Line Number="268"><![CDATA[                            sLH := 1;]]></Line>
<Line Number="269"><![CDATA[                            sRH := 0;]]></Line>
<Line Number="270"><![CDATA[                            sCurve := TD_BadCurve;]]></Line>
<Line Number="271"><![CDATA[                            sPlantReset := 1;]]></Line>
<Line Number="272"><![CDATA[                            sStep := 31;]]></Line>
<Line Number="273"><![CDATA[                            sTim := 0;]]></Line>
<Line Number="274"><![CDATA[                        31:]]></Line>
<Line Number="275"><![CDATA[                            IF Station.CntTotal >= 3 OR sTim > 4000 THEN]]></Line>
<Line Number="276"><![CDATA[                                IF sTim > 4000 THEN]]></Line>
<Line Number="277"><![CDATA[                                    sCk := 29;]]></Line>
<Line Number="278"><![CDATA[                                ELSIF Station.Verdict <> 2 THEN]]></Line>
<Line Number="279"><![CDATA[                                    sCk := 21;]]></Line>
<Line Number="280"><![CDATA[                                ELSIF Station.NokCode <> 5 THEN]]></Line>
<Line Number="281"><![CDATA[                                    sCk := 22;]]></Line>
<Line Number="282"><![CDATA[                                ELSIF Station.CntConsecNok <> 2 THEN]]></Line>
<Line Number="283"><![CDATA[                                    sCk := 24;]]></Line>
<Line Number="284"><![CDATA[                                ELSIF NOT Plant.Moved THEN]]></Line>
<Line Number="285"><![CDATA[                                    sCk := 25;]]></Line>
<Line Number="286"><![CDATA[                                END_IF;]]></Line>
<Line Number="287"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="288"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="289"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="290"><![CDATA[                                sStep := 32;]]></Line>
<Line Number="291"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="292"><![CDATA[                            END_IF;]]></Line>
<Line Number="293"><![CDATA[                        32:  // into the chute]]></Line>
<Line Number="294"><![CDATA[                            sChute := sTim >= 20 AND sTim < 25;]]></Line>
<Line Number="295"><![CDATA[                            IF (sTim >= 40 AND Station.State = 0) OR sTim > 4000 THEN]]></Line>
<Line Number="296"><![CDATA[                                sStep := 40;]]></Line>
<Line Number="297"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="298"><![CDATA[                            END_IF;]]></Line>
<Line Number="299"><![CDATA[                        40:  // the same defect again: third reject in a row]]></Line>
<Line Number="300"><![CDATA[                            sPart := 1;]]></Line>
<Line Number="301"><![CDATA[                            sCurve := TD_BadCurve;]]></Line>
<Line Number="302"><![CDATA[                            sPlantReset := 1;]]></Line>
<Line Number="303"><![CDATA[                            sStep := 41;]]></Line>
<Line Number="304"><![CDATA[                            sTim := 0;]]></Line>
<Line Number="305"><![CDATA[                        41:]]></Line>
<Line Number="306"><![CDATA[                            IF Station.CntTotal >= 4 OR sTim > 4000 THEN]]></Line>
<Line Number="307"><![CDATA[                                IF sTim > 4000 THEN]]></Line>
<Line Number="308"><![CDATA[                                    sCk := 29;]]></Line>
<Line Number="309"><![CDATA[                                ELSIF Station.Verdict <> 2 THEN]]></Line>
<Line Number="310"><![CDATA[                                    sCk := 21;]]></Line>
<Line Number="311"><![CDATA[                                ELSIF Station.NokCode <> 5 THEN]]></Line>
<Line Number="312"><![CDATA[                                    sCk := 22;]]></Line>
<Line Number="313"><![CDATA[                                ELSIF Station.CntConsecNok <> 3 THEN]]></Line>
<Line Number="314"><![CDATA[                                    sCk := 24;]]></Line>
<Line Number="315"><![CDATA[                                END_IF;]]></Line>
<Line Number="316"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="317"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="318"><![CDATA[                                sStep := 42;]]></Line>
<Line Number="319"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="320"><![CDATA[                            END_IF;]]></Line>
<Line Number="321"><![CDATA[                        42:  // into the chute; then a good unit is put in]]></Line>
<Line Number="322"><![CDATA[                            sChute := sTim >= 20 AND sTim < 25;]]></Line>
<Line Number="323"><![CDATA[                            IF sTim >= 40 THEN]]></Line>
<Line Number="324"><![CDATA[                                IF sCk = 0 AND Station.State <> 0 THEN]]></Line>
<Line Number="325"><![CDATA[                                    sCk := 27;]]></Line>
<Line Number="326"><![CDATA[                                ELSIF sCk = 0 AND (NOT Station.RigCheckRequired OR NOT Station.QCallOperator) THEN]]></Line>
<Line Number="327"><![CDATA[                                    sCk := 28;]]></Line>
<Line Number="328"><![CDATA[                                END_IF;]]></Line>
<Line Number="329"><![CDATA[                                sPart := 1;]]></Line>
<Line Number="330"><![CDATA[                                sCurve := TD_GoodCurve;]]></Line>
<Line Number="331"><![CDATA[                                sPlantReset := 1;]]></Line>
<Line Number="332"><![CDATA[                                sStep := 43;]]></Line>
<Line Number="333"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="334"><![CDATA[                            END_IF;]]></Line>
<Line Number="335"><![CDATA[                        43:  // the start must stay blocked until the acknowledge]]></Line>
<Line Number="336"><![CDATA[                            IF sTim >= 400 THEN]]></Line>
<Line Number="337"><![CDATA[                                IF sCk = 0 AND (Station.State <> 0 OR Station.CntTotal <> 4 OR Plant.Moved) THEN]]></Line>
<Line Number="338"><![CDATA[                                    sCk := 28;]]></Line>
<Line Number="339"><![CDATA[                                END_IF;]]></Line>
<Line Number="340"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="341"><![CDATA[                                sStep := 50;]]></Line>
<Line Number="342"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="343"><![CDATA[                            END_IF;]]></Line>
<Line Number="344"><![CDATA[                        50:  // acknowledge key; the good unit is then tested]]></Line>
<Line Number="345"><![CDATA[                            sAck := sTim < 5;]]></Line>
<Line Number="346"><![CDATA[                            IF Station.CntTotal >= 5 OR sTim > 4000 THEN]]></Line>
<Line Number="347"><![CDATA[                                IF sTim > 4000 THEN]]></Line>
<Line Number="348"><![CDATA[                                    sCk := 29;]]></Line>
<Line Number="349"><![CDATA[                                ELSIF Station.RigCheckRequired THEN]]></Line>
<Line Number="350"><![CDATA[                                    sCk := 28;]]></Line>
<Line Number="351"><![CDATA[                                ELSIF Station.Verdict <> 1 THEN]]></Line>
<Line Number="352"><![CDATA[                                    sCk := 21;]]></Line>
<Line Number="353"><![CDATA[                                ELSIF Station.NokCode <> 0 THEN]]></Line>
<Line Number="354"><![CDATA[                                    sCk := 22;]]></Line>
<Line Number="355"><![CDATA[                                ELSIF Station.CntOk <> 2 OR Station.CntConsecNok <> 0 THEN]]></Line>
<Line Number="356"><![CDATA[                                    sCk := 24;]]></Line>
<Line Number="357"><![CDATA[                                END_IF;]]></Line>
<Line Number="358"><![CDATA[                                sNok := Station.NokCode;]]></Line>
<Line Number="359"><![CDATA[                                sRecord := 1;]]></Line>
<Line Number="360"><![CDATA[                                sPart := 0;]]></Line>
<Line Number="361"><![CDATA[                                sAck := 0;]]></Line>
<Line Number="362"><![CDATA[                                sStep := 51;]]></Line>
<Line Number="363"><![CDATA[                                sTim := 0;]]></Line>
<Line Number="364"><![CDATA[                            END_IF;]]></Line>
<Line Number="365"><![CDATA[                        51:  // unit taken out]]></Line>
<Line Number="366"><![CDATA[                            IF Station.State = 0 OR sTim > 4000 THEN]]></Line>
<Line Number="367"><![CDATA[                                sStep := 99;]]></Line>
<Line Number="368"><![CDATA[                            END_IF;]]></Line>
<Line Number="369"><![CDATA[                        ELSE]]></Line>
<Line Number="370"><![CDATA[                            sPhase := 3;]]></Line>
<Line Number="371"><![CDATA[                    END_CASE;]]></Line>
<Line Number="372"><![CDATA[                    Plant.Reset := sPlantReset;]]></Line>
<Line Number="373"><![CDATA[                    Plant.CycleTime := 0.002;]]></Line>
<Line Number="374"><![CDATA[                    Plant.QVel := Station.QVel;]]></Line>
<Line Number="375"><![CDATA[                    Plant.QDriveEnable := Station.QDriveEnable;]]></Line>
<Line Number="376"><![CDATA[                    Plant.QClamp := Station.QClamp;]]></Line>
<Line Number="377"><![CDATA[                    Plant.PartPresent := sPart;]]></Line>
<Line Number="378"><![CDATA[                    Plant.Curve := sCurve;]]></Line>
<Line Number="379"><![CDATA[                    Plant.Seat := 5.0;]]></Line>
<Line Number="380"><![CDATA[                    AOI_TestPlant(Plant, TD_X, TD_F, TD_CurveStart, TD_CurveNPull);]]></Line>
<Line Number="381"><![CDATA[                    sPlantReset := 0;]]></Line>
<Line Number="382"><![CDATA[                    Station.CycleTime := 0.002;]]></Line>
<Line Number="383"><![CDATA[                    Station.SafetyOk := 1;]]></Line>
<Line Number="384"><![CDATA[                    Station.DriveOk := 1;]]></Line>
<Line Number="385"><![CDATA[                    Station.AckFault := sAck;]]></Line>
<Line Number="386"><![CDATA[                    Station.StartEnable := 1;]]></Line>
<Line Number="387"><![CDATA[                    Station.PartPresent := sPart;]]></Line>
<Line Number="388"><![CDATA[                    Station.SensLH := sPart AND sLH;]]></Line>
<Line Number="389"><![CDATA[                    Station.SensRH := sPart AND sRH;]]></Line>
<Line Number="390"><![CDATA[                    Station.VariantLH := 1;]]></Line>
<Line Number="391"><![CDATA[                    Station.ClampClosed := Plant.ClampClosed;]]></Line>
<Line Number="392"><![CDATA[                    Station.ClampOpen := Plant.ClampOpen;]]></Line>
<Line Number="393"><![CDATA[                    Station.RejectChute := sChute;]]></Line>
<Line Number="394"><![CDATA[                    Station.Pos := Plant.Pos;]]></Line>
<Line Number="395"><![CDATA[                    Station.Force := Plant.Force;]]></Line>
<Line Number="396"><![CDATA[                    Station.Compliance := 0.0;]]></Line>
<Line Number="397"><![CDATA[                    AOI_HandleStation(Station, StationRcp, StationCnt);]]></Line>
<Line Number="398"><![CDATA[                END_IF;]]></Line>
<Line Number="399"><![CDATA[            END_FOR;]]></Line>
<Line Number="400"><![CDATA[        END_IF;]]></Line>
<Line Number="401"><![CDATA[]]></Line>
<Line Number="402"><![CDATA[    // --- Record ---]]></Line>
<Line Number="403"><![CDATA[        IF sRecord THEN]]></Line>
<Line Number="404"><![CDATA[            sRun := sRun + 1;]]></Line>
<Line Number="405"><![CDATA[            IF sCk = 0 THEN]]></Line>
<Line Number="406"><![CDATA[                sPassed := sPassed + 1;]]></Line>
<Line Number="407"><![CDATA[                TR_CasePass[sCase] := 1;]]></Line>
<Line Number="408"><![CDATA[            ELSE]]></Line>
<Line Number="409"><![CDATA[                sFailed := sFailed + 1;]]></Line>
<Line Number="410"><![CDATA[                IF sFirstCase = 0 THEN]]></Line>
<Line Number="411"><![CDATA[                    sFirstCase := sCase;]]></Line>
<Line Number="412"><![CDATA[                    sFirstCheck := sCk;]]></Line>
<Line Number="413"><![CDATA[                END_IF;]]></Line>
<Line Number="414"><![CDATA[            END_IF;]]></Line>
<Line Number="415"><![CDATA[            TR_CaseCheck[sCase] := sCk;]]></Line>
<Line Number="416"><![CDATA[            TR_CaseNok[sCase] := sNok;]]></Line>
<Line Number="417"><![CDATA[            sCase := sCase + 1;]]></Line>
<Line Number="418"><![CDATA[            sCk := 0;]]></Line>
<Line Number="419"><![CDATA[            sNok := 0;]]></Line>
<Line Number="420"><![CDATA[            sRecord := 0;]]></Line>
<Line Number="421"><![CDATA[            IF sPhase = 1 AND sCase > TD_NCases THEN]]></Line>
<Line Number="422"><![CDATA[                sPhase := 2;]]></Line>
<Line Number="423"><![CDATA[            END_IF;]]></Line>
<Line Number="424"><![CDATA[        END_IF;]]></Line>
<Line Number="425"><![CDATA[]]></Line>
<Line Number="426"><![CDATA[    // --- Result ---]]></Line>
<Line Number="427"><![CDATA[        TR_CasesTotal := TD_NCases + 6;]]></Line>
<Line Number="428"><![CDATA[        TR_CasesRun := sRun;]]></Line>
<Line Number="429"><![CDATA[        TR_CasesPassed := sPassed;]]></Line>
<Line Number="430"><![CDATA[        TR_CasesFailed := sFailed;]]></Line>
<Line Number="431"><![CDATA[        TR_FirstFailedCase := sFirstCase;]]></Line>
<Line Number="432"><![CDATA[        TR_FirstFailedCheck := sFirstCheck;]]></Line>
<Line Number="433"><![CDATA[        TR_MaxFeatError := sMaxErr;]]></Line>
<Line Number="434"><![CDATA[        TR_BenchCalls := sCalls;]]></Line>
<Line Number="435"><![CDATA[        TR_Done := sPhase = 3;]]></Line>
<Line Number="436"><![CDATA[        TR_AllPassed := sPhase = 3 AND sFailed = 0 AND sPassed = TD_NCases + 6;]]></Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="StationProgram" TestEdits="false" MainRoutineName="Station" Disabled="false" UseAsFolder="false">
<Description><![CDATA[The station on the machine. Runs in the periodic task StationTask; its Rate must equal Station.CycleTime.]]></Description><Tags>
<Tag Name="Station" TagType="Base" DataType="AOI_HandleStation" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Structure DataType="AOI_HandleStation"><DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/><DataValueMember Name="EnableOut" DataType="BOOL" Value="0"/><DataValueMember Name="CycleTime" DataType="REAL" Radix="Float" Value="0.002"/><DataValueMember Name="SafetyOk" DataType="BOOL" Value="0"/><DataValueMember Name="DriveOk" DataType="BOOL" Value="0"/><DataValueMember Name="AckFault" DataType="BOOL" Value="0"/><DataValueMember Name="StartEnable" DataType="BOOL" Value="0"/><DataValueMember Name="PartPresent" DataType="BOOL" Value="0"/><DataValueMember Name="SensLH" DataType="BOOL" Value="0"/><DataValueMember Name="SensRH" DataType="BOOL" Value="0"/><DataValueMember Name="VariantLH" DataType="BOOL" Value="0"/><DataValueMember Name="ClampClosed" DataType="BOOL" Value="0"/><DataValueMember Name="ClampOpen" DataType="BOOL" Value="0"/><DataValueMember Name="RejectChute" DataType="BOOL" Value="0"/><DataValueMember Name="Pos" DataType="REAL" Radix="Float" Value="0.0"/><DataValueMember Name="Force" DataType="REAL" Radix="Float" Value="0.0"/><DataValueMember Name="VPull" DataType="REAL" Radix="Float" Value="50.0"/><DataValueMember Name="VHome" DataType="REAL" Radix="Float" Value="150.0"/><DataValueMember Name="FTouch" DataType="REAL" Radix="Float" Value="1.5"/><DataValueMember Name="FRev" DataType="REAL" Radix="Float" Value="40.0"/><DataValueMember Name="FAbsMax" DataType="REAL" Radix="Float" Value="60.0"/><DataValueMember Name="XMax" DataType="REAL" Radix="Float" Value="38.0"/><DataValueMember Name="TouchLo" DataType="REAL" Radix="Float" Value="3.0"/><DataValueMember Name="TouchHi" DataType="REAL" Radix="Float" Value="7.0"/><DataValueMember Name="Compliance" DataType="REAL" Radix="Float" Value="0.025"/><DataValueMember Name="TareTol" DataType="REAL" Radix="Float" Value="0.5"/><DataValueMember Name="TPresent" DataType="REAL" Radix="Float" 