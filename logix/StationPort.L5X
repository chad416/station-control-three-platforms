<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="34.01" TargetName="StationPort" TargetType="Controller" ContainsContext="false" ExportDate="Wed Nov 25 00:00:00 2026" ExportOptions="NoRawData DecoratedData ForceProtectedEncoding AllProjDocTrans">
<Controller Use="Target" Name="StationPort" ProcessorType="1756-L85E" MajorRev="34" MinorRev="11">
<Description><![CDATA[Port of the door-handle force-travel station (Siemens SCL / CODESYS ST) to Logix. Not compiled.]]></Description><DataTypes>
<DataType Name="ST_EvalRecipe" Family="NoFamily" Class="User"><Description><![CDATA[Evaluation recipe of AOI_CurveEval. Arrays must be InOut (AOI Input/Output: atomic types only).]]></Description><Members>
<Member Name="Mode" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="GateX" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="Gate2X" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakXLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakXHi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="StepSpan" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="StopF" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="G1Lo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="G1Hi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="MeanLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="MeanHi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="HystLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="HystHi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="RetFMin" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="G2Lo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="G2Hi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakFLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakFHi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakXMin" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="PeakXMax" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="StepLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="StopXLo" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="StopXHi" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="EnvX0" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="EnvDx" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="EnvN" DataType="INT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="EnvLo" DataType="REAL" Dimension="64" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="EnvHi" DataType="REAL" Dimension="64" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
</Members></DataType>
</DataTypes>
<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="AOI_CurveEval" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Force-travel curve evaluation, one sample per call. Port of FB_CurveEval.]]></Description><Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Sample" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Stroke" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="X" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="F" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="Finish" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Rcp" TagType="Base" DataType="ST_EvalRecipe" Usage="InOut" Required="true" Visible="true"></Parameter>
<Parameter Name="FpG1" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FrG1" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FMean" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FHyst" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FpG2" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FPeak" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="XPeak" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="FStep" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="XStop" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="EnvViol" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="EnvNodes" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="NSamples" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Done" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Ok" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="NokCode" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="sHavePrev" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sPrevX" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sPrevF" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sPrevStroke" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sGotG1" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sGotG2" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sGotR1" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sGotPeak" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sGotStop" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sFMin" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFpG1" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFrG1" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFMean" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFHyst" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFpG2" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFPeak" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sXPeak" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sFStep" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sXStop" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sEnvViol" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sEnvNodes" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sNSamples" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sDone" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sOk" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sNokCode" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tI" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tNodeX" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tFn" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tCode" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[]]></Line>
<Line Number="1"><![CDATA[    // --- Reset ---]]></Line>
<Line Number="2"><![CDATA[        IF Reset THEN]]></Line>
<Line Number="3"><![CDATA[            sFpG1 := 0.0;]]></Line>
<Line Number="4"><![CDATA[            sFrG1 := 0.0;]]></Line>
<Line Number="5"><![CDATA[            sFMean := 0.0;]]></Line>
<Line Number="6"><![CDATA[            sFHyst := 0.0;]]></Line>
<Line Number="7"><![CDATA[            sFpG2 := 0.0;]]></Line>
<Line Number="8"><![CDATA[            sFPeak := 0.0;]]></Line>
<Line Number="9"><![CDATA[            sXPeak := 0.0;]]></Line>
<Line Number="10"><![CDATA[            sFStep := 0.0;]]></Line>
<Line Number="11"><![CDATA[            sXStop := 0.0;]]></Line>
<Line Number="12"><![CDATA[            sEnvViol := 0;]]></Line>
<Line Number="13"><![CDATA[            sEnvNodes := 0;]]></Line>
<Line Number="14"><![CDATA[            sNSamples := 0;]]></Line>
<Line Number="15"><![CDATA[            sDone := 0;]]></Line>
<Line Number="16"><![CDATA[            sOk := 0;]]></Line>
<Line Number="17"><![CDATA[            sNokCode := 0;]]></Line>
<Line Number="18"><![CDATA[            sHavePrev := 0;]]></Line>
<Line Number="19"><![CDATA[            sGotG1 := 0;]]></Line>
<Line Number="20"><![CDATA[            sGotG2 := 0;]]></Line>
<Line Number="21"><![CDATA[            sGotR1 := 0;]]></Line>
<Line Number="22"><![CDATA[            sGotPeak := 0;]]></Line>
<Line Number="23"><![CDATA[            sGotStop := 0;]]></Line>
<Line Number="24"><![CDATA[            sFMin := 0.0;]]></Line>
<Line Number="25"><![CDATA[        END_IF;]]></Line>
<Line Number="26"><![CDATA[]]></Line>
<Line Number="27"><![CDATA[    // --- PullStroke ---]]></Line>
<Line Number="28"><![CDATA[        IF NOT Reset AND Sample AND NOT sDone AND Stroke = 1 THEN]]></Line>
<Line Number="29"><![CDATA[            IF sHavePrev AND sPrevStroke = 1 THEN]]></Line>
<Line Number="30"><![CDATA[                // gates: force at a set travel, linear between the two samples around it]]></Line>
<Line Number="31"><![CDATA[                IF NOT sGotG1 AND sPrevX < Rcp.GateX AND X >= Rcp.GateX THEN]]></Line>
<Line Number="32"><![CDATA[                    sFpG1 := sPrevF + (F - sPrevF) * (Rcp.GateX - sPrevX) / (X - sPrevX);]]></Line>
<Line Number="33"><![CDATA[                    sGotG1 := 1;]]></Line>
<Line Number="34"><![CDATA[                END_IF;]]></Line>
<Line Number="35"><![CDATA[                IF NOT sGotG2 AND sPrevX < Rcp.Gate2X AND X >= Rcp.Gate2X THEN]]></Line>
<Line Number="36"><![CDATA[                    sFpG2 := sPrevF + (F - sPrevF) * (Rcp.Gate2X - sPrevX) / (X - sPrevX);]]></Line>
<Line Number="37"><![CDATA[                    sGotG2 := 1;]]></Line>
<Line Number="38"><![CDATA[                END_IF;]]></Line>
<Line Number="39"><![CDATA[                // end stop: travel at a set force]]></Line>
<Line Number="40"><![CDATA[                IF NOT sGotStop AND sPrevX > Rcp.Gate2X AND sPrevF < Rcp.StopF AND F >= Rcp.StopF THEN]]></Line>
<Line Number="41"><![CDATA[                    sXStop := sPrevX + (X - sPrevX) * (Rcp.StopF - sPrevF) / (F - sPrevF);]]></Line>
<Line Number="42"><![CDATA[                    sGotStop := 1;]]></Line>
<Line Number="43"><![CDATA[                END_IF;]]></Line>
<Line Number="44"><![CDATA[                // envelope: at most four nodes can lie between two samples]]></Line>
<Line Number="45"><![CDATA[                FOR tI := 1 TO 4 DO]]></Line>
<Line Number="46"><![CDATA[                    tNodeX := Rcp.EnvX0 + Rcp.EnvDx * sEnvNodes;]]></Line>
<Line Number="47"><![CDATA[                    IF sEnvNodes < Rcp.EnvN AND sPrevX < tNodeX AND X >= tNodeX THEN]]></Line>
<Line Number="48"><![CDATA[                        tFn := sPrevF + (F - sPrevF) * (tNodeX - sPrevX) / (X - sPrevX);]]></Line>
<Line Number="49"><![CDATA[                        IF tFn < Rcp.EnvLo[sEnvNodes] OR tFn > Rcp.EnvHi[sEnvNodes] THEN]]></Line>
<Line Number="50"><![CDATA[                            sEnvViol := sEnvViol + 1;]]></Line>
<Line Number="51"><![CDATA[                        END_IF;]]></Line>
<Line Number="52"><![CDATA[                        sEnvNodes := sEnvNodes + 1;]]></Line>
<Line Number="53"><![CDATA[                    END_IF;]]></Line>
<Line Number="54"><![CDATA[                END_FOR;]]></Line>
<Line Number="55"><![CDATA[            END_IF;]]></Line>
<Line Number="56"><![CDATA[            // latch release: peak inside the window, then the drop after it]]></Line>
<Line Number="57"><![CDATA[            IF X >= Rcp.PeakXLo AND X <= Rcp.PeakXHi AND (NOT sGotPeak OR F > sFPeak) THEN]]></Line>
<Line Number="58"><![CDATA[                sFPeak := F;]]></Line>
<Line Number="59"><![CDATA[                sXPeak := X;]]></Line>
<Line Number="60"><![CDATA[                sFMin := F;]]></Line>
<Line Number="61"><![CDATA[                sGotPeak := 1;]]></Line>
<Line Number="62"><![CDATA[            ELSIF sGotPeak AND X <= sXPeak + Rcp.StepSpan AND F < sFMin THEN]]></Line>
<Line Number="63"><![CDATA[                sFMin := F;]]></Line>
<Line Number="64"><![CDATA[            END_IF;]]></Line>
<Line Number="65"><![CDATA[            IF sGotPeak THEN]]></Line>
<Line Number="66"><![CDATA[                sFStep := sFPeak - sFMin;]]></Line>
<Line Number="67"><![CDATA[            END_IF;]]></Line>
<Line Number="68"><![CDATA[        END_IF;]]></Line>
<Line Number="69"><![CDATA[]]></Line>
<Line Number="70"><![CDATA[    // --- ReturnStroke ---]]></Line>
<Line Number="71"><![CDATA[        IF NOT Reset AND Sample AND NOT sDone AND Stroke = 2 AND sHavePrev THEN]]></Line>
<Line Number="72"><![CDATA[            IF NOT sGotR1 AND sPrevX > Rcp.GateX AND X <= Rcp.GateX THEN]]></Line>
<Line Number="73"><![CDATA[                sFrG1 := sPrevF + (F - sPrevF) * (Rcp.GateX - sPrevX) / (X - sPrevX);]]></Line>
<Line Number="74"><![CDATA[                sGotR1 := 1;]]></Line>
<Line Number="75"><![CDATA[            END_IF;]]></Line>
<Line Number="76"><![CDATA[        END_IF;]]></Line>
<Line Number="77"><![CDATA[]]></Line>
<Line Number="78"><![CDATA[    // --- Bookkeeping ---]]></Line>
<Line Number="79"><![CDATA[        IF NOT Reset AND Sample AND NOT sDone THEN]]></Line>
<Line Number="80"><![CDATA[            sPrevX := X;]]></Line>
<Line Number="81"><![CDATA[            sPrevF := F;]]></Line>
<Line Number="82"><![CDATA[            sPrevStroke := Stroke;]]></Line>
<Line Number="83"><![CDATA[            sHavePrev := 1;]]></Line>
<Line Number="84"><![CDATA[            IF sNSamples < 32000 THEN]]></Line>
<Line Number="85"><![CDATA[                sNSamples := sNSamples + 1;]]></Line>
<Line Number="86"><![CDATA[            END_IF;]]></Line>
<Line Number="87"><![CDATA[        END_IF;]]></Line>
<Line Number="88"><![CDATA[]]></Line>
<Line Number="89"><![CDATA[    // --- Verdict ---]]></Line>
<Line Number="90"><![CDATA[        IF NOT Reset AND Finish AND NOT sDone THEN]]></Line>
<Line Number="91"><![CDATA[            sFMean := (sFpG1 + sFrG1) * 0.5;]]></Line>
<Line Number="92"><![CDATA[            sFHyst := sFpG1 - sFrG1;]]></Line>
<Line Number="93"><![CDATA[            tCode := 0;]]></Line>
<Line Number="94"><![CDATA[            CASE Rcp.Mode OF]]></Line>
<Line Number="95"><![CDATA[                1:  // peak force only]]></Line>
<Line Number="96"><![CDATA[                    IF NOT sGotPeak THEN]]></Line>
<Line Number="97"><![CDATA[                        tCode := 1;]]></Line>
<Line Number="98"><![CDATA[                    ELSIF sFPeak < Rcp.PeakFLo OR sFPeak > Rcp.PeakFHi THEN]]></Line>
<Line Number="99"><![CDATA[                        tCode := 6;]]></Line>
<Line Number="100"><![CDATA[                    END_IF;]]></Line>
<Line Number="101"><![CDATA[                2, 3:  // windows; mode 3 judges gate 1 with the return stroke]]></Line>
<Line Number="102"><![CDATA[                    IF NOT (sGotG1 AND sGotG2 AND sGotPeak AND sGotStop) THEN]]></Line>
<Line Number="103"><![CDATA[                        tCode := 1;]]></Line>
<Line Number="104"><![CDATA[                    ELSIF Rcp.Mode = 3 AND NOT sGotR1 THEN]]></Line>
<Line Number="105"><![CDATA[                        tCode := 1;]]></Line>
<Line Number="106"><![CDATA[                    ELSIF Rcp.Mode = 2 AND (sFpG1 < Rcp.G1Lo OR sFpG1 > Rcp.G1Hi) THEN]]></Line>
<Line Number="107"><![CDATA[                        tCode := 2;]]></Line>
<Line Number="108"><![CDATA[                    ELSIF Rcp.Mode = 3 AND (sFMean < Rcp.MeanLo OR sFMean > Rcp.MeanHi) THEN]]></Line>
<Line Number="109"><![CDATA[                        tCode := 2;]]></Line>
<Line Number="110"><![CDATA[                    ELSIF Rcp.Mode = 3 AND (sFHyst < Rcp.HystLo OR sFHyst > Rcp.HystHi) THEN]]></Line>
<Line Number="111"><![CDATA[                        tCode := 3;]]></Line>
<Line Number="112"><![CDATA[                    ELSIF Rcp.Mode = 3 AND sFrG1 < Rcp.RetFMin THEN]]></Line>
<Line Number="113"><![CDATA[                        tCode := 4;]]></Line>
<Line Number="114"><![CDATA[                    ELSIF sFpG2 < Rcp.G2Lo OR sFpG2 > Rcp.G2Hi THEN]]></Line>
<Line Number="115"><![CDATA[                        tCode := 5;]]></Line>
<Line Number="116"><![CDATA[                    ELSIF sFPeak < Rcp.PeakFLo OR sFPeak > Rcp.PeakFHi THEN]]></Line>
<Line Number="117"><![CDATA[                        tCode := 6;]]></Line>
<Line Number="118"><![CDATA[                    ELSIF sXPeak < Rcp.PeakXMin OR sXPeak > Rcp.PeakXMax THEN]]></Line>
<Line Number="119"><![CDATA[                        tCode := 7;]]></Line>
<Line Number="120"><![CDATA[                    ELSIF sFStep < Rcp.StepLo THEN]]></Line>
<Line Number="121"><![CDATA[                        tCode := 8;]]></Line>
<Line Number="122"><![CDATA[                    ELSIF sXStop < Rcp.StopXLo OR sXStop > Rcp.StopXHi THEN]]></Line>
<Line Number="123"><![CDATA[                        tCode := 9;]]></Line>
<Line Number="124"><![CDATA[                    END_IF;]]></Line>
<Line Number="125"><![CDATA[                4:  // envelope: every node reached and inside]]></Line>
<Line Number="126"><![CDATA[                    IF sEnvNodes < Rcp.EnvN THEN]]></Line>
<Line Number="127"><![CDATA[                        tCode := 1;]]></Line>
<Line Number="128"><![CDATA[                    ELSIF sEnvViol > 0 THEN]]></Line>
<Line Number="129"><![CDATA[                        tCode := 10;]]></Line>
<Line Number="130"><![CDATA[                    END_IF;]]></Line>
<Line Number="131"><![CDATA[                ELSE]]></Line>
<Line Number="132"><![CDATA[                    tCode := 1;]]></Line>
<Line Number="133"><![CDATA[            END_CASE;]]></Line>
<Line Number="134"><![CDATA[            sNokCode := tCode;]]></Line>
<Line Number="135"><![CDATA[            sOk := tCode = 0;]]></Line>
<Line Number="136"><![CDATA[            sDone := 1;]]></Line>
<Line Number="137"><![CDATA[        END_IF;]]></Line>
<Line Number="138"><![CDATA[]]></Line>
<Line Number="139"><![CDATA[    // --- Outputs ---]]></Line>
<Line Number="140"><![CDATA[        // the working values live in static variables; the outputs are written here and nowhere else]]></Line>
<Line Number="141"><![CDATA[        FpG1 := sFpG1;]]></Line>
<Line Number="142"><![CDATA[        FrG1 := sFrG1;]]></Line>
<Line Number="143"><![CDATA[        FMean := sFMean;]]></Line>
<Line Number="144"><![CDATA[        FHyst := sFHyst;]]></Line>
<Line Number="145"><![CDATA[        FpG2 := sFpG2;]]></Line>
<Line Number="146"><![CDATA[        FPeak := sFPeak;]]></Line>
<Line Number="147"><![CDATA[        XPeak := sXPeak;]]></Line>
<Line Number="148"><![CDATA[        FStep := sFStep;]]></Line>
<Line Number="149"><![CDATA[        XStop := sXStop;]]></Line>
<Line Number="150"><![CDATA[        EnvViol := sEnvViol;]]></Line>
<Line Number="151"><![CDATA[        EnvNodes := sEnvNodes;]]></Line>
<Line Number="152"><![CDATA[        NSamples := sNSamples;]]></Line>
<Line Number="153"><![CDATA[        Done := sDone;]]></Line>
<Line Number="154"><![CDATA[        Ok := sOk;]]></Line>
<Line Number="155"><![CDATA[        NokCode := sNokCode;]]></Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_TestPlant" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Test bench only: stand-in for axis, clamp and handle. Port of FB_TestPlant.]]></Description><Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="CycleTime" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.002"/></DefaultData></Parameter>
<Parameter Name="QVel" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="QDriveEnable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="QClamp" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="PartPresent" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Curve" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Seat" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="5.0"/></DefaultData></Parameter>
<Parameter Name="X" TagType="Base" DataType="REAL" Dimensions="5932" Usage="InOut" Radix="Float" Required="true" Visible="true"></Parameter>
<Parameter Name="F" TagType="Base" DataType="REAL" Dimensions="5932" Usage="InOut" Radix="Float" Required="true" Visible="true"></Parameter>
<Parameter Name="CurveStart" TagType="Base" DataType="INT" Dimensions="16" Usage="InOut" Radix="Decimal" Required="true" Visible="true"></Parameter>
<Parameter Name="CurveNPull" TagType="Base" DataType="INT" Dimensions="16" Usage="InOut" Radix="Decimal" Required="true" Visible="true"></Parameter>
<Parameter Name="Pos" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="Force" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="ClampClosed" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="ClampOpen" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Moved" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="sPos" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sClamp" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="sReturn" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sK" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="sMoved" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tI" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tA" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tN" DataType="INT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></LocalTag>
<LocalTag Name="tX" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tF" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tX0" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tX1" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tF0" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
<LocalTag Name="tF1" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[]]></Line>
<Line Number="1"><![CDATA[    // --- Part ---]]></Line>
<Line Number="2"><![CDATA[        IF Reset THEN]]></Line>
<Line Number="3"><![CDATA[            sReturn := 0;]]></Line>
<Line Number="4"><![CDATA[            sK := 0;]]></Line>
<Line Number="5"><![CDATA[            sMoved := 0;]]></Line>
<Line Number="6"><![CDATA[        END_IF;]]></Line>
<Line Number="7"><![CDATA[]]></Line>
<Line Number="8"><![CDATA[    // --- AxisAndClamp ---]]></Line>
<Line Number="9"><![CDATA[        IF QDriveEnable THEN]]></Line>
<Line Number="10"><![CDATA[            sPos := sPos + QVel * CycleTime;]]></Line>
<Line Number="11"><![CDATA[            IF QVel <> 0.0 THEN]]></Line>
<Line Number="12"><![CDATA[                sMoved := 1;]]></Line>
<Line Number="13"><![CDATA[            END_IF;]]></Line>
<Line Number="14"><![CDATA[        END_IF;]]></Line>
<Line Number="15"><![CDATA[        IF sPos < 0.0 THEN]]></Line>
<Line Number="16"><![CDATA[            sPos := 0.0;]]></Line>
<Line Number="17"><![CDATA[        END_IF;]]></Line>
<Line Number="18"><![CDATA[        IF QClamp THEN]]></Line>
<Line Number="19"><![CDATA[            sClamp := sClamp + CycleTime;]]></Line>
<Line Number="20"><![CDATA[            sMoved := 1;]]></Line>
<Line Number="21"><![CDATA[        ELSE]]></Line>
<Line Number="22"><![CDATA[            sClamp := sClamp - CycleTime;]]></Line>
<Line Number="23"><![CDATA[        END_IF;]]></Line>
<Line Number="24"><![CDATA[        IF sClamp < 0.0 THEN]]></Line>
<Line Number="25"><![CDATA[            sClamp := 0.0;]]></Line>
<Line Number="26"><![CDATA[        ELSIF sClamp > 0.25 THEN]]></Line>
<Line Number="27"><![CDATA[            sClamp := 0.25;]]></Line>
<Line Number="28"><![CDATA[        END_IF;]]></Line>
<Line Number="29"><![CDATA[]]></Line>
<Line Number="30"><![CDATA[    // --- Handle ---]]></Line>
<Line Number="31"><![CDATA[        tX := sPos - Seat;]]></Line>
<Line Number="32"><![CDATA[        tF := 0.0;]]></Line>
<Line Number="33"><![CDATA[        tA := CurveStart[Curve];]]></Line>
<Line Number="34"><![CDATA[        tN := CurveNPull[Curve];]]></Line>
<Line Number="35"><![CDATA[        IF QVel < 0.0 AND NOT sReturn THEN]]></Line>
<Line Number="36"><![CDATA[            sReturn := 1;]]></Line>
<Line Number="37"><![CDATA[            sK := 0;]]></Line>
<Line Number="38"><![CDATA[        END_IF;]]></Line>
<Line Number="39"><![CDATA[        IF PartPresent AND tX >= 0.0 AND tN >= 2 THEN]]></Line>
<Line Number="40"><![CDATA[            IF sReturn THEN]]></Line>
<Line Number="41"><![CDATA[                tA := tA + tN;   // the return samples follow the pull samples; their travel falls]]></Line>
<Line Number="42"><![CDATA[            END_IF;]]></Line>
<Line Number="43"><![CDATA[            // move on to the pair of samples around the travel (the axis moves less than 8 samples per call)]]></Line>
<Line Number="44"><![CDATA[            FOR tI := 1 TO 8 DO]]></Line>
<Line Number="45"><![CDATA[                IF sK < tN - 2 THEN]]></Line>
<Line Number="46"><![CDATA[                    IF NOT sReturn AND X[tA + sK + 1] < tX THEN]]></Line>
<Line Number="47"><![CDATA[                        sK := sK + 1;]]></Line>
<Line Number="48"><![CDATA[                    ELSIF sReturn AND X[tA + sK + 1] > tX THEN]]></Line>
<Line Number="49"><![CDATA[                        sK := sK + 1;]]></Line>
<Line Number="50"><![CDATA[                    END_IF;]]></Line>
<Line Number="51"><![CDATA[                END_IF;]]></Line>
<Line Number="52"><![CDATA[            END_FOR;]]></Line>
<Line Number="53"><![CDATA[            tX0 := X[tA + sK];]]></Line>
<Line Number="54"><![CDATA[            tX1 := X[tA + sK + 1];]]></Line>
<Line Number="55"><![CDATA[            tF0 := F[tA + sK];]]></Line>
<Line Number="56"><![CDATA[            tF1 := F[tA + sK + 1];]]></Line>
<Line Number="57"><![CDATA[            IF NOT sReturn THEN]]></Line>
<Line Number="58"><![CDATA[                IF tX >= tX1 THEN]]></Line>
<Line Number="59"><![CDATA[                    tF := tF1 + (tX - tX1) * 25.0;]]></Line>
<Line Number="60"><![CDATA[                ELSIF tX <= tX0 OR tX1 - tX0 < 0.000001 THEN]]></Line>
<Line Number="61"><![CDATA[                    tF := tF0;]]></Line>
<Line Number="62"><![CDATA[                ELSE]]></Line>
<Line Number="63"><![CDATA[                    tF := tF0 + (tF1 - tF0) * (tX - tX0) / (tX1 - tX0);]]></Line>
<Line Number="64"><![CDATA[                END_IF;]]></Line>
<Line Number="65"><![CDATA[            ELSE]]></Line>
<Line Number="66"><![CDATA[                IF tX >= tX0 THEN]]></Line>
<Line Number="67"><![CDATA[                    tF := tF0 + (tX - tX0) * 25.0;]]></Line>
<Line Number="68"><![CDATA[                ELSIF tX <= tX1 OR tX0 - tX1 < 0.000001 THEN]]></Line>
<Line Number="69"><![CDATA[                    tF := tF1;]]></Line>
<Line Number="70"><![CDATA[                ELSE]]></Line>
<Line Number="71"><![CDATA[                    tF := tF1 + (tF0 - tF1) * (tX - tX1) / (tX0 - tX1);]]></Line>
<Line Number="72"><![CDATA[                END_IF;]]></Line>
<Line Number="73"><![CDATA[            END_IF;]]></Line>
<Line Number="74"><![CDATA[        END_IF;]]></Line>
<Line Number="75"><![CDATA[]]></Line>
<Line Number="76"><![CDATA[    // --- Outputs ---]]></Line>
<Line Number="77"><![CDATA[        Pos := sPos;]]></Line>
<Line Number="78"><![CDATA[        Force := tF;]]></Line>
<Line Number="79"><![CDATA[        ClampClosed := sClamp >= 0.25;]]></Line>
<Line Number="80"><![CDATA[        ClampOpen := sClamp <= 0.0;]]></Line>
<Line Number="81"><![CDATA[        Moved := sMoved;]]></Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="AOI_HandleStation" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Description><![CDATA[Force-travel test station: sequence, poka-yoke, counters. Port of FB_HandleStation.]]></Description><Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="CycleTime" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.002"/></DefaultData></Parameter>
<Parameter Name="SafetyOk" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="DriveOk" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="AckFault" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="StartEnable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="PartPresent" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="SensLH" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="SensRH" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="VariantLH" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="ClampClosed" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="ClampOpen" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="RejectChute" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="Pos" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="Force" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="VPull" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="50.0"/></DefaultData></Parameter>
<Parameter Name="VHome" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="150.0"/></DefaultData></Parameter>
<Parameter Name="FTouch" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="1.5"/></DefaultData></Parameter>
<Parameter Name="FRev" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="40.0"/></DefaultData></Parameter>
<Parameter Name="FAbsMax" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="60.0"/></DefaultData></Parameter>
<Parameter Name="XMax" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="38.0"/></DefaultData></Parameter>
<Parameter Name="TouchLo" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="3.0"/></DefaultData></Parameter>
<Parameter Name="TouchHi" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="7.0"/></DefaultData></Parameter>
<Parameter Name="Compliance" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.025"/></DefaultData></Parameter>
<Parameter Name="TareTol" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.5"/></DefaultData></Parameter>
<Parameter Name="TPresent" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.1"/></DefaultData></Parameter>
<Parameter Name="TClampMax" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="1.0"/></DefaultData></Parameter>
<Parameter Name="TRejectWarn" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="30.0"/></DefaultData></Parameter>
<Parameter Name="MaxConsecNok" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="3"/></DefaultData></Parameter>
<Parameter Name="Rcp" TagType="Base" DataType="ST_EvalRecipe" Usage="InOut" Required="true" Visible="true"></Parameter>
<Parameter Name="CntByCode" TagType="Base" DataType="DINT" Dimensions="32" Usage="InOut" Radix="Decimal" Required="true" Visible="true"></Parameter>
<Parameter Name="QClamp" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="QDriveEnable" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="QVel" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0"/></DefaultData></Parameter>
<Parameter Name="QLampOk" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="QLampNok" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="QCallOperator" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></DefaultData></Parameter>
<Parameter Name="State" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></DefaultData></Parameter>
