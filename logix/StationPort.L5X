<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0"><![CDATA[]]></Line>
<Line Number="1"><![CDATA[    // --- Inputs ---]]></Line>
<Line Number="2"><![CDATA[        FNet := Force - sTare;]]></Line>
<Line Number="3"><![CDATA[        tChuteEdge := RejectChute AND NOT sChutePrev;]]></Line>
<Line Number="4"><![CDATA[        sChutePrev := RejectChute;]]></Line>
<Line Number="5"><![CDATA[        sTim := sTim + CycleTime;]]></Line>
<Line Number="6"><![CDATA[        sTCycle := sTCycle + CycleTime;]]></Line>
<Line Number="7"><![CDATA[        QVel := 0.0;]]></Line>
<Line Number="8"><![CDATA[        // exactly the sensor of the expected hand, and not the other one]]></Line>
<Line Number="9"><![CDATA[        tVariantOk := (VariantLH AND SensLH AND NOT SensRH) OR (NOT VariantLH AND SensRH AND NOT SensLH);]]></Line>
<Line Number="10"><![CDATA[]]></Line>
<Line Number="11"><![CDATA[    // --- Faults ---]]></Line>
<Line Number="12"><![CDATA[        IF sState <> 9 AND (NOT SafetyOk OR NOT DriveOk) THEN]]></Line>
<Line Number="13"><![CDATA[            IF NOT SafetyOk THEN]]></Line>
<Line Number="14"><![CDATA[                FaultCode := 1;]]></Line>
<Line Number="15"><![CDATA[            ELSE]]></Line>
<Line Number="16"><![CDATA[                FaultCode := 2;]]></Line>
<Line Number="17"><![CDATA[            END_IF;]]></Line>
<Line Number="18"><![CDATA[            IF sState <> 10 THEN]]></Line>
<Line Number="19"><![CDATA[                sInTest := sState >= 1 AND sState <= 6;]]></Line>
<Line Number="20"><![CDATA[                sWasLocked := sState = 8;]]></Line>
<Line Number="21"><![CDATA[            END_IF;]]></Line>
<Line Number="22"><![CDATA[            sState := 9;]]></Line>
<Line Number="23"><![CDATA[        END_IF;]]></Line>
<Line Number="24"><![CDATA[]]></Line>
<Line Number="25"><![CDATA[    // --- Sequence ---]]></Line>
<Line Number="26"><![CDATA[        CASE sState OF]]></Line>
<Line Number="27"><![CDATA[            0:  // Idle]]></Line>
<Line Number="28"><![CDATA[                Locked := 0;]]></Line>
<Line Number="29"><![CDATA[                IF NOT PartPresent THEN]]></Line>
<Line Number="30"><![CDATA[                    sTim := 0.0;]]></Line>
<Line Number="31"><![CDATA[                    QLampOk := 0;]]></Line>
<Line Number="32"><![CDATA[                    QLampNok := 0;]]></Line>
<Line Number="33"><![CDATA[                ELSIF sTim >= TPresent AND StartEnable AND ClampOpen AND NOT sRigCheckRequired THEN]]></Line>
<Line Number="34"><![CDATA[                    Verdict := 0;]]></Line>
<Line Number="35"><![CDATA[                    NokCode := 0;]]></Line>
<Line Number="36"><![CDATA[                    sPreNok := 0;]]></Line>
<Line Number="37"><![CDATA[                    sTCycle := 0.0;]]></Line>
<Line Number="38"><![CDATA[                    sTim := 0.0;]]></Line>
<Line Number="39"><![CDATA[                    IF tVariantOk THEN]]></Line>
<Line Number="40"><![CDATA[                        sState := 1;]]></Line>
<Line Number="41"><![CDATA[                    ELSE]]></Line>
<Line Number="42"><![CDATA[                        sPreNok := 20;   // never pull a part of the wrong hand]]></Line>
<Line Number="43"><![CDATA[                        sState := 6;]]></Line>
<Line Number="44"><![CDATA[                    END_IF;]]></Line>
<Line Number="45"><![CDATA[                END_IF;]]></Line>
<Line Number="46"><![CDATA[            1:  // Clamp]]></Line>
<Line Number="47"><![CDATA[                QClamp := 1;]]></Line>
<Line Number="48"><![CDATA[                IF ClampClosed THEN]]></Line>
<Line Number="49"><![CDATA[                    sTim := 0.0;]]></Line>
<Line Number="50"><![CDATA[                    sState := 2;]]></Line>
<Line Number="51"><![CDATA[                ELSIF sTim > TClampMax THEN]]></Line>
<Line Number="52"><![CDATA[                    FaultCode := 3;]]></Line>
<Line Number="53"><![CDATA[                    sInTest := 1;]]></Line>
<Line Number="54"><![CDATA[                    sState := 9;]]></Line>
<Line Number="55"><![CDATA[                END_IF;]]></Line>
<Line Number="56"><![CDATA[            2:  // Tare]]></Line>
<Line Number="57"><![CDATA[                IF sTim >= 0.05 THEN]]></Line>
<Line Number="58"><![CDATA[                    IF ABS(Force) > TareTol THEN]]></Line>
<Line Number="59"><![CDATA[                        FaultCode := 4;]]></Line>
<Line Number="60"><![CDATA[                        sInTest := 1;]]></Line>
<Line Number="61"><![CDATA[                        sState := 9;]]></Line>
<Line Number="62"><![CDATA[                    ELSE]]></Line>
<Line Number="63"><![CDATA[                        sTare := Force;]]></Line>
<Line Number="64"><![CDATA[                        COP(Rcp, sRcp, 1);   // the recipe of this part]]></Line>
<Line Number="65"><![CDATA[                        Eval.Reset := 1;]]></Line>
<Line Number="66"><![CDATA[                        Eval.Sample := 0;]]></Line>
<Line Number="67"><![CDATA[                        Eval.Stroke := 0;]]></Line>
<Line Number="68"><![CDATA[                        Eval.X := 0.0;]]></Line>
<Line Number="69"><![CDATA[                        Eval.F := 0.0;]]></Line>
<Line Number="70"><![CDATA[                        Eval.Finish := 0;]]></Line>
<Line Number="71"><![CDATA[                        AOI_CurveEval(Eval, sRcp);]]></Line>
<Line Number="72"><![CDATA[                        sState := 3;]]></Line>
<Line Number="73"><![CDATA[                    END_IF;]]></Line>
<Line Number="74"><![CDATA[                END_IF;]]></Line>
<Line Number="75"><![CDATA[            3:  // Approach]]></Line>
<Line Number="76"><![CDATA[                QVel := VPull;]]></Line>
<Line Number="77"><![CDATA[                IF FNet > FTouch THEN]]></Line>
<Line Number="78"><![CDATA[                    sTouchPos := Pos;]]></Line>
<Line Number="79"><![CDATA[                    sFTouch := FNet;]]></Line>
<Line Number="80"><![CDATA[                    IF Pos < TouchLo OR Pos > TouchHi THEN]]></Line>
<Line Number="81"><![CDATA[                        sPreNok := 21;]]></Line>
<Line Number="82"><![CDATA[                        sState := 5;]]></Line>
<Line Number="83"><![CDATA[                    ELSE]]></Line>
<Line Number="84"><![CDATA[                        XTravel := 0.0;]]></Line>
<Line Number="85"><![CDATA[                        Eval.Reset := 0;]]></Line>
<Line Number="86"><![CDATA[                        Eval.Sample := 1;]]></Line>
<Line Number="87"><![CDATA[                        Eval.Stroke := 1;]]></Line>
<Line Number="88"><![CDATA[                        Eval.X := 0.0;]]></Line>
<Line Number="89"><![CDATA[                        Eval.F := FNet;]]></Line>
<Line Number="90"><![CDATA[                        Eval.Finish := 0;]]></Line>
<Line Number="91"><![CDATA[                        AOI_CurveEval(Eval, sRcp);]]></Line>
<Line Number="92"><![CDATA[                        sState := 4;]]></Line>
<Line Number="93"><![CDATA[                    END_IF;]]></Line>
<Line Number="94"><![CDATA[                ELSIF Pos > TouchHi THEN]]></Line>
<Line Number="95"><![CDATA[                    sPreNok := 21;]]></Line>
<Line Number="96"><![CDATA[                    sTouchPos := Pos;]]></Line>
<Line Number="97"><![CDATA[                    sFTouch := 0.0;]]></Line>
<Line Number="98"><![CDATA[                    sState := 5;]]></Line>
<Line Number="99"><![CDATA[                END_IF;]]></Line>
<Line Number="100"><![CDATA[            4:  // Pull]]></Line>
<Line Number="101"><![CDATA[                QVel := VPull;]]></Line>
<Line Number="102"><![CDATA[                XTravel := Pos - sTouchPos - (FNet - sFTouch) * Compliance;]]></Line>
<Line Number="103"><![CDATA[                Eval.Reset := 0;]]></Line>
<Line Number="104"><![CDATA[                Eval.Sample := 1;]]></Line>
<Line Number="105"><![CDATA[                Eval.Stroke := 1;]]></Line>
<Line Number="106"><![CDATA[                Eval.X := XTravel;]]></Line>
<Line Number="107"><![CDATA[                Eval.F := FNet;]]></Line>
<Line Number="108"><![CDATA[                Eval.Finish := 0;]]></Line>
<Line Number="109"><![CDATA[                AOI_CurveEval(Eval, sRcp);]]></Line>
<Line Number="110"><![CDATA[                IF FNet >= FAbsMax THEN]]></Line>
<Line Number="111"><![CDATA[                    sPreNok := 22;]]></Line>
<Line Number="112"><![CDATA[                    sState := 5;]]></Line>
<Line Number="113"><![CDATA[                ELSIF FNet >= FRev THEN]]></Line>
<Line Number="114"><![CDATA[                    sState := 5;]]></Line>
<Line Number="115"><![CDATA[                ELSIF XTravel >= XMax THEN]]></Line>
<Line Number="116"><![CDATA[                    sPreNok := 23;]]></Line>
<Line Number="117"><![CDATA[                    sState := 5;]]></Line>
<Line Number="118"><![CDATA[                END_IF;]]></Line>
<Line Number="119"><![CDATA[            5:  // Return]]></Line>
<Line Number="120"><![CDATA[                XTravel := Pos - sTouchPos - (FNet - sFTouch) * Compliance;]]></Line>
<Line Number="121"><![CDATA[                IF Pos > sTouchPos - 0.5 THEN]]></Line>
<Line Number="122"><![CDATA[                    QVel := -VPull;]]></Line>
<Line Number="123"><![CDATA[                    IF sPreNok = 0 THEN]]></Line>
<Line Number="124"><![CDATA[                        Eval.Reset := 0;]]></Line>
<Line Number="125"><![CDATA[                        Eval.Sample := 1;]]></Line>
<Line Number="126"><![CDATA[                        Eval.Stroke := 2;]]></Line>
<Line Number="127"><![CDATA[                        Eval.X := XTravel;]]></Line>
<Line Number="128"><![CDATA[                        Eval.F := FNet;]]></Line>
<Line Number="129"><![CDATA[                        Eval.Finish := 0;]]></Line>
<Line Number="130"><![CDATA[                        AOI_CurveEval(Eval, sRcp);]]></Line>
<Line Number="131"><![CDATA[                    END_IF;]]></Line>
<Line Number="132"><![CDATA[                ELSIF Pos > 0.05 THEN]]></Line>
<Line Number="133"><![CDATA[                    QVel := -VHome;]]></Line>
<Line Number="134"><![CDATA[                ELSE]]></Line>
<Line Number="135"><![CDATA[                    sState := 6;]]></Line>
<Line Number="136"><![CDATA[                END_IF;]]></Line>
<Line Number="137"><![CDATA[            6:  // Evaluate]]></Line>
<Line Number="138"><![CDATA[                IF sPreNok <> 0 THEN]]></Line>
<Line Number="139"><![CDATA[                    tCode := sPreNok;]]></Line>
<Line Number="140"><![CDATA[                ELSE]]></Line>
<Line Number="141"><![CDATA[                    Eval.Reset := 0;]]></Line>
<Line Number="142"><![CDATA[                    Eval.Sample := 0;]]></Line>
<Line Number="143"><![CDATA[                    Eval.Stroke := 0;]]></Line>
<Line Number="144"><![CDATA[                    Eval.X := 0.0;]]></Line>
<Line Number="145"><![CDATA[                    Eval.F := 0.0;]]></Line>
<Line Number="146"><![CDATA[                    Eval.Finish := 1;]]></Line>
<Line Number="147"><![CDATA[                    AOI_CurveEval(Eval, sRcp);]]></Line>
<Line Number="148"><![CDATA[                    tCode := Eval.NokCode;]]></Line>
<Line Number="149"><![CDATA[                END_IF;]]></Line>
<Line Number="150"><![CDATA[                NokCode := tCode;]]></Line>
<Line Number="151"><![CDATA[                TCycle := sTCycle;]]></Line>
<Line Number="152"><![CDATA[                sCntTotal := sCntTotal + 1;]]></Line>
<Line Number="153"><![CDATA[                sCntByCode[tCode] := sCntByCode[tCode] + 1;]]></Line>
<Line Number="154"><![CDATA[                QClamp := 0;]]></Line>
<Line Number="155"><![CDATA[                sTim := 0.0;]]></Line>
<Line Number="156"><![CDATA[                IF tCode = 0 THEN]]></Line>
<Line Number="157"><![CDATA[                    Verdict := 1;]]></Line>
<Line Number="158"><![CDATA[                    sCntOk := sCntOk + 1;]]></Line>
<Line Number="159"><![CDATA[                    sCntConsecNok := 0;]]></Line>
<Line Number="160"><![CDATA[                    QLampOk := 1;]]></Line>
<Line Number="161"><![CDATA[                    sState := 7;]]></Line>
<Line Number="162"><![CDATA[                ELSE]]></Line>
<Line Number="163"><![CDATA[                    Verdict := 2;]]></Line>
<Line Number="164"><![CDATA[                    sCntNok := sCntNok + 1;]]></Line>
<Line Number="165"><![CDATA[                    sCntConsecNok := sCntConsecNok + 1;]]></Line>
<Line Number="166"><![CDATA[                    QLampNok := 1;]]></Line>
<Line Number="167"><![CDATA[                    sPartGone := 0;]]></Line>
<Line Number="168"><![CDATA[                    sState := 8;]]></Line>
<Line Number="169"><![CDATA[                END_IF;]]></Line>
<Line Number="170"><![CDATA[            7:  // UnloadOk]]></Line>
<Line Number="171"><![CDATA[                QClamp := 0;]]></Line>
<Line Number="172"><![CDATA[                IF NOT PartPresent AND ClampOpen THEN]]></Line>
<Line Number="173"><![CDATA[                    sTim := 0.0;]]></Line>
<Line Number="174"><![CDATA[                    sState := 0;]]></Line>
<Line Number="175"><![CDATA[                END_IF;]]></Line>
<Line Number="176"><![CDATA[            8:  // RejectLock]]></Line>
<Line Number="177"><![CDATA[                QClamp := 0;]]></Line>
<Line Number="178"><![CDATA[                Locked := 1;]]></Line>
<Line Number="179"><![CDATA[                IF NOT PartPresent THEN]]></Line>
<Line Number="180"><![CDATA[                    sPartGone := 1;]]></Line>
<Line Number="181"><![CDATA[                END_IF;]]></Line>
<Line Number="182"><![CDATA[                QCallOperator := sTim > TRejectWarn OR sRigCheckRequired;]]></Line>
<Line Number="183"><![CDATA[                IF sPartGone AND tChuteEdge THEN]]></Line>
<Line Number="184"><![CDATA[                    sCntRejectConfirmed := sCntRejectConfirmed + 1;]]></Line>
<Line Number="185"><![CDATA[                    sRigCheckRequired := sCntConsecNok >= MaxConsecNok;]]></Line>
<Line Number="186"><![CDATA[                    QCallOperator := sRigCheckRequired;]]></Line>
<Line Number="187"><![CDATA[                    Locked := 0;]]></Line>
<Line Number="188"><![CDATA[                    sTim := 0.0;]]></Line>
<Line Number="189"><![CDATA[                    sState := 0;]]></Line>
<Line Number="190"><![CDATA[                END_IF;]]></Line>
<Line Number="191"><![CDATA[            9:  // Fault]]></Line>
<Line Number="192"><![CDATA[                QClamp := sInTest;]]></Line>
<Line Number="193"><![CDATA[                QCallOperator := 1;]]></Line>
<Line Number="194"><![CDATA[                IF AckFault AND SafetyOk AND DriveOk THEN]]></Line>
<Line Number="195"><![CDATA[                    FaultCode := 0;]]></Line>
<Line Number="196"><![CDATA[                    QCallOperator := 0;]]></Line>
<Line Number="197"><![CDATA[                    sState := 10;]]></Line>
<Line Number="198"><![CDATA[                END_IF;]]></Line>
<Line Number="199"><![CDATA[            10:  // Home]]></Line>
<Line Number="200"><![CDATA[                IF Pos > 0.05 THEN]]></Line>
<Line Number="201"><![CDATA[                    QVel := -VPull;]]></Line>
<Line Number="202"><![CDATA[                ELSIF sInTest THEN]]></Line>
<Line Number="203"><![CDATA[                    sInTest := 0;]]></Line>
<Line Number="204"><![CDATA[                    sPreNok := 24;]]></Line>
<Line Number="205"><![CDATA[                    sState := 6;]]></Line>
<Line Number="206"><![CDATA[                ELSIF sWasLocked THEN]]></Line>
<Line Number="207"><![CDATA[                    sWasLocked := 0;   // a fault does not release the reject lock]]></Line>
<Line Number="208"><![CDATA[                    sState := 8;]]></Line>
<Line Number="209"><![CDATA[                ELSE]]></Line>
<Line Number="210"><![CDATA[                    sState := 0;]]></Line>
<Line Number="211"><![CDATA[                END_IF;]]></Line>
<Line Number="212"><![CDATA[            ELSE]]></Line>
<Line Number="213"><![CDATA[                sState := 9;]]></Line>
<Line Number="214"><![CDATA[        END_CASE;]]></Line>
<Line Number="215"><![CDATA[]]></Line>
<Line Number="216"><![CDATA[    // --- RigCheck ---]]></Line>
<Line Number="217"><![CDATA[        // the lock after too many rejects in a row is released by the acknowledge key]]></Line>
<Line Number="218"><![CDATA[        IF sRigCheckRequired AND AckFault AND sState = 0 THEN]]></Line>
<Line Number="219"><![CDATA[            sRigCheckRequired := 0;]]></Line>
<Line Number="220"><![CDATA[            sCntConsecNok := 0;]]></Line>
<Line Number="221"><![CDATA[            QCallOperator := 0;]]></Line>
<Line Number="222"><![CDATA[        END_IF;]]></Line>
<Line Number="223"><![CDATA[        QDriveEnable := SafetyOk AND DriveOk AND sState <> 9;]]></Line>
<Line Number="224"><![CDATA[]]></Line>
<Line Number="225"><![CDATA[    // --- Outputs ---]]></Line>
<Line Number="226"><![CDATA[        // state and counters live in static variables; these outputs are written here and nowhere else]]></Line>
<Line Number="227"><![CDATA[        State := sState;]]></Line>
<Line Number="228"><![CDATA[        RigCheckRequired := sRigCheckRequired;]]></Line>
<Line Number="229"><![CDATA[        CntTotal := sCntTotal;]]></Line>
<Line Number="230"><![CDATA[        CntOk := sCntOk;]]></Line>
<Line Number="231"><![CDATA[        CntNok := sCntNok;]]></Line>
<Line Number="232"><![CDATA[        CntRejectConfirmed := sCntRejectConfirmed;]]></Line>
<Line Number="233"><![CDATA[        CntConsecNok := sCntConsecNok;]]></Line>
<Line Number="234"><![CDATA[        COP(sCntByCode[0], CntByCode[0], 32);   // InOut array: Logix allows no array outputs]]></Line>
<Line Number="235"><![CDATA[]]></Line>
<Line Number="236"><![CDATA[        // the curve elements of the last part for the operator screen: the local tag Eval cannot be]]></Line>
<Line Number="237"><![CDATA[        // read from outside the AOI (Siemens and CODESYS screens read Station.Eval directly)]]></Line>
<Line Number="238"><![CDATA[        E_FpG1 := Eval.FpG1;]]></Line>
<Line Number="239"><![CDATA[        E_FrG1 := Eval.FrG1;]]></Line>
<Line Number="240"><![CDATA[        E_FMean := Eval.FMean;]]></Line>
<Line Number="241"><![CDATA[        E_FHyst := Eval.FHyst;]]></Line>
<Line Number="242"><![CDATA[        E_FpG2 := Eval.FpG2;]]></Line>
<Line Number="243"><![CDATA[        E_FPeak := Eval.FPeak;]]></Line>
<Line Number="244"><![CDATA[        E_XPeak := Eval.XPeak;]]></Line>
<Line Number="245"><![CDATA[        E_FStep := Eval.FStep;]]></Line>
<Line Number="246"><![CDATA[        E_XStop := Eval.XStop;]]></Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
<Tag Name="TD_NCurves" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="10"/></Data></Tag>
<Tag Name="TD_NCases" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="14"/></Data></Tag>
<Tag Name="TD_NSamples" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="5932"/></Data></Tag>
<Tag Name="TD_Tol" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.001"/></Data></Tag>
<Tag Name="TD_GoodCurve" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0"/></Data></Tag>
<Tag Name="TD_BadCurve" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="6"/></Data></Tag>
<Tag Name="TD_GateX" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="3.0"/></Data></Tag>
<Tag Name="TD_Gate2X" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="10.0"/></Data></Tag>
<Tag Name="TD_PeakXLo" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="13.0"/></Data></Tag>
<Tag Name="TD_PeakXHi" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="26.0"/></Data></Tag>
<Tag Name="TD_StepSpan" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="2.0"/></Data></Tag>
<Tag Name="TD_StopF" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="30.0"/></Data></Tag>
<Tag Name="TD_EnvX0" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="1.0"/></Data></Tag>
<Tag Name="TD_EnvDx" TagType="Base" DataType="REAL" Radix="Float" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.5"/></Data></Tag>
<Tag Name="TD_EnvN" TagType="Base" DataType="INT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="55"/></Data></Tag>
<Tag Name="TD_CurveStart" TagType="Base" DataType="INT" Dimensions="16" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="INT" Dimensions="16" Radix="Decimal"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="620"/><Element Index="[2]" Value="1246"/><Element Index="[3]" Value="1746"/><Element Index="[4]" Value="2366"/><Element Index="[5]" Value="2988"/><Element Index="[6]" Value="3606"/><Element Index="[7]" Value="4228"/><Element Index="[8]" Value="4728"/><Element Index="[9]" Value="5310"/><Element Index="[10]" Value="0"/><Element Index="[11]" Value="0"/><Element Index="[12]" Value="0"/><Element Index="[13]" Value="0"/><Element Index="[14]" Value="0"/><Element Index="[15]" Value="0"/></Array></Data></Tag>
<Tag Name="TD_CurveNPull" TagType="Base" DataType="INT" Dimensions="16" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="INT" Dimensions="16" Radix="Decimal"><Element Index="[0]" Value="310"/><Element Index="[1]" Value="313"/><Element Index="[2]" Value="250"/><Element Index="[3]" Value="310"/><Element Index="[4]" Value="311"/><Element Index="[5]" Value="309"/><Element Index="[6]" Value="311"/><Element Index="[7]" Value="250"/><Element Index="[8]" Value="291"/><Element Index="[9]" Value="311"/><Element Index="[10]" Value="0"/><Element Index="[11]" Value="0"/><Element Index="[12]" Value="0"/><Element Index="[13]" Value="0"/><Element Index="[14]" Value="0"/><Element Index="[15]" Value="0"/></Array></Data></Tag>
<Tag Name="TD_CaseCurve" TagType="Base" DataType="INT" Dimensions="33" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="INT" Dimensions="33" Radix="Decimal"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="0"/><Element Index="[2]" Value="1"/><Element Index="[3]" Value="2"/><Element Index="[4]" Value="3"/><Element Index="[5]" Value="4"/><Element Index="[6]" Value="5"/><Element Index="[7]" Value="6"/><Element Index="[8]" Value="7"/><Element Index="[9]" Value="8"/><Element Index="[10]" Value="9"/><Element Index="[11]" Value="9"/><Element Index="[12]" Value="8"/><Element Index="[13]" Value="0"/><Element Index="[14]" Value="3"/><Element Index="[15]" Value="0"/><Element Index="[16]" Value="0"/><Element Index="[17]" Value="0"/><Element Index="[18]" Value="0"/><Element Index="[19]" Value="0"/><Element Index="[20]" Value="0"/><Element Index="[21]" Value="0"/><Element Index="[22]" Value="0"/><Element Index="[23]" Value="0"/><Element Index="[24]" Value="0"/><Element Index="[25]" Value="0"/><Element Index="[26]" Value="0"/><Element Index="[27]" Value="0"/><Element Index="[28]" Value="0"/><Element Index="[29]" Value="0"/><Element Index="[30]" Value="0"/><Element Index="[31]" Value="0"/><Element Index="[32]" Value="0"/></Array></Data></Tag>
<Tag Name="TD_CaseMode" TagType="Base" DataType="INT" Dimensions="33" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="INT" Dimensions="33" Radix="Decimal"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="3"/><Element Index="[2]" Value="3"/><Element Index="[3]" Value="3"/><Element Index="[4]" Value="3"/><Element Index="[5]" Value="3"/><Element Index="[6]" Value="3"/><Element Index="[7]" Value="3"/><Element Index="[8]" Value="3"/><Element Index="[9]" Value="3"/><Element Index="[10]" Value="3"/><Element Index="[11]" Value="2"/><Element Index="[12]" Value="1"/><Element Index="[13]" Value="4"/><Element Index="[14]" Value="4"/><Element Index="[15]" Value="0"/><Element Index="[16]" Value="0"/><Element Index="[17]" Value="0"/><Element Index="[18]" Value="0"/><Element Index="[19]" Value="0"/><Element Index="[20]" Value="0"/><Element Index="[21]" Value="0"/><Element Index="[22]" Value="0"/><Element Index="[23]" Value="0"/><Element Index="[24]" Value="0"/><Element Index="[25]" Value="0"/><Element Index="[26]" Value="0"/><Element Index="[27]" Value="0"/><Element Index="[28]" Value="0"/><Element Index="[29]" Value="0"/><Element Index="[30]" Value="0"/><Element Index="[31]" Value="0"/><Element Index="[32]" Value="0"/></Array></Data></Tag>
<Tag Name="TD_ExpOk" TagType="Base" DataType="BOOL" Dimensions="64" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"><Data Format="Decorated"><Array DataType="BOOL" Dimensions="64"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="1"/><Element Index="[2]" Value="1"/><Element Index="[3]" Value="0"/><Element Index="[4]" Value="0"/><Element Index="[5]" Value="0"/><Element Index="[6]" Value="0"/><Element Index="[7]" Value="0"/><Element Index="[8]" Value="0"/><Element Index="[9]" Value="0"/><Element Index="[10]" Value="0"/><Element Index="[11]" Value="1"/><Element Index="[12]" Value="1"/><Element Index="[13]" Value="1"/><Element Index="[14]" Value="1"/><Element Index="[15]" Value="0"/><Element Index="[16]" Value="0"/><Element Index="[17]" Value="0"/><Element Index="[18]" Value="0"/><Element Index="[19]" Value="0"/><Element Index="[20]" Value="0"/><Element Index="[21]" Value="0"/><Element Index="[22]" Value="0"/><Element Index="[23]" Value="0"/><Element Index="[24]" Value="0"/><Element Index="[25]" Value="0"/><Element Index="[26]" Value="0"/><Element Index="[27]" Value="0"/><Element Index="[28]" Value="0"/><Element Index="[29]" Value="0"/><Element Index="[30]" Value="0"/><Element Index="[31]" Value="0"/><Element Index="[32]" Value="0"/><Element Index="[33]" Value="0"/><Element Index="[34]" Value="0"/><Element Index="[35]" Value="0"/><Element Index="[36]" Value="0"/><Element Index="[37]" Value="0"/><Element Index="[38]" Value="0"/><Element Index="[39]" Value="0"/><Element Index="[40]" Value="0"/><Element Index="[41]" Value="0"/><Element Index="[42]" Value="0"/><Element Index="[43]" Value="0"/><Element Index="[44]" Value="0"/><Element Index="[45]" Value="0"/><Element Index="[46]" Value="0"/><Element Index="[47]" Value="0"/><Element Index="[48]" Value="0"/><Element Index="[49]" Value="0"/><Element Index="[50]" Value="0"/><Element Index="[51]" Value="0"/><Element Index="[52]" Value="0"/><Element Index="[53]" Value="0"/><Element Index="[54]" Value="0"/><E