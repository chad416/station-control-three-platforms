  <types>
    <dataTypes />
    <pous>
      <pou name="FB_TestPlant" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="Reset">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> a new part is in the fixture</xhtml>
              </documentation>
            </variable>
            <variable name="CycleTime">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.002" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> s</xhtml>
              </documentation>
            </variable>
            <variable name="QVel">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> mm/s</xhtml>
              </documentation>
            </variable>
            <variable name="QDriveEnable">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="QClamp">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="PartPresent">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Curve">
              <type>
                <INT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> recorded curve the part follows</xhtml>
              </documentation>
            </variable>
            <variable name="Seat">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="5.0" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> mm, axis position at which the hook meets the grip</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Pos">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> mm</xhtml>
              </documentation>
            </variable>
            <variable name="Force">
              <type>
                <REAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> N</xhtml>
              </documentation>
            </variable>
            <variable name="ClampClosed">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ClampOpen">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Moved">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> the axis has moved or the clamp has closed since the last Reset</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="sPos">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sClamp">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sReturn">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="sK">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="sMoved">
              <type>
                <BOOL />
              </type>
            </variable>
          </localVars>
          <tempVars>
            <variable name="tI">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tA">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tN">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tX">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="tF">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="tX0">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="tX1">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="tF0">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="tF1">
              <type>
                <REAL />
              </type>
            </variable>
          </tempVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">    {region "Part"}
        IF Reset THEN
            sReturn := FALSE;
            sK := 0;
            sMoved := FALSE;
        END_IF;
    {endregion}

    {region "AxisAndClamp"}
        IF QDriveEnable THEN
            sPos := sPos + QVel * CycleTime;
            IF QVel &lt;&gt; 0.0 THEN
                sMoved := TRUE;
            END_IF;
        END_IF;
        IF sPos &lt; 0.0 THEN
            sPos := 0.0;
        END_IF;
        IF QClamp THEN
            sClamp := sClamp + CycleTime;
            sMoved := TRUE;
        ELSE
            sClamp := sClamp - CycleTime;
        END_IF;
        sClamp := LIMIT(0.0, sClamp, 0.25);
    {endregion}

    {region "Handle"}
        tX := sPos - Seat;
        tF := 0.0;
        tA := GVL_TestData.CurveStart[Curve];
        tN := GVL_TestData.CurveNPull[Curve];
        IF QVel &lt; 0.0 AND NOT sReturn THEN
            sReturn := TRUE;
            sK := 0;
        END_IF;
        IF PartPresent AND tX &gt;= 0.0 AND tN &gt;= 2 THEN
            IF sReturn THEN
                tA := tA + tN;   // the return samples follow the pull samples; their travel falls
            END_IF;
            // move on to the pair of samples around the travel (the axis moves less than 8 samples per call)
            FOR tI := 1 TO 8 DO
                IF sK &lt; tN - 2 THEN
                    IF NOT sReturn AND GVL_TestData.X[tA + sK + 1] &lt; tX THEN
                        sK := sK + 1;
                    ELSIF sReturn AND GVL_TestData.X[tA + sK + 1] &gt; tX THEN
                        sK := sK + 1;
                    END_IF;
                END_IF;
            END_FOR;
            tX0 := GVL_TestData.X[tA + sK];
            tX1 := GVL_TestData.X[tA + sK + 1];
            tF0 := GVL_TestData.F[tA + sK];
            tF1 := GVL_TestData.F[tA + sK + 1];
            IF NOT sReturn THEN
                IF tX &gt;= tX1 THEN
                    tF := tF1 + (tX - tX1) * 25.0;
                ELSIF tX &lt;= tX0 OR tX1 - tX0 &lt; 0.000001 THEN
                    tF := tF0;
                ELSE
                    tF := tF0 + (tF1 - tF0) * (tX - tX0) / (tX1 - tX0);
                END_IF;
            ELSE
                IF tX &gt;= tX0 THEN
                    tF := tF0 + (tX - tX0) * 25.0;
                ELSIF tX &lt;= tX1 OR tX0 - tX1 &lt; 0.000001 THEN
                    tF := tF1;
                ELSE
                    tF := tF1 + (tF0 - tF1) * (tX - tX1) / (tX0 - tX1);
                END_IF;
            END_IF;
        END_IF;
    {endregion}

    {region "Outputs"}
        Pos := sPos;
        Force := tF;
        ClampClosed := sClamp &gt;= 0.25;
        ClampOpen := sClamp &lt;= 0.0;
        Moved := sMoved;
    {endregion}
</xhtml>
          </ST>
        </body>
        <addData />
      </pou>
    </pous>
