              </type>
            </variable>
            <variable name="sFrG1">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sFMean">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sFHyst">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sFpG2">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sFPeak">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sXPeak">
              <type>
                <REAL />
              </type>
            </variable>
            <variable name="sFStep">
              <type>
                <REAL />
              </type>
            </variable>
